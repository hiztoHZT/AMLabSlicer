<UserControl x:Class="AMLabSlicer.Plugins.Agent.Views.AgentSettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:AMLabSlicer.Plugin.Wpf.Localization;assembly=AMLabSlicer.Plugin.Wpf">
<UserControl.Resources>
<Style x:Key="SettingsHeading" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
<Style x:Key="SettingsLabel" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
<Style x:Key="SettingsHint" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/><Setter Property="Margin" Value="0,4,0,8"/></Style>
</UserControl.Resources>
<StackPanel>                    <Border Style="{StaticResource SettingsCardStyle}"><StackPanel>
                        <TextBlock Text="{loc:Text Key='Agent 对话服务'}" Style="{StaticResource SettingsHeading}"/>
                        <TextBlock Text="{loc:Text Key='服务基础地址（含 /v1/）'}"/>
                        <TextBox Text="{Binding AgentEndpoint, UpdateSourceTrigger=LostFocus}" Margin="0,4,0,8"/>
                        <TextBlock Text="{loc:Text Key='模型名称'}"/>
                        <TextBox Text="{Binding AgentModel, UpdateSourceTrigger=LostFocus}" Margin="0,4,0,8"/>
                        <TextBlock Text="{loc:Text Key='API Key 环境变量名称（本地服务可留空）'}" TextWrapping="Wrap"/>
                        <TextBox Text="{Binding AgentApiKeyVariable, UpdateSourceTrigger=LostFocus}" Margin="0,4,0,8"/>
                        <TextBlock Text="{loc:Text Key='这里填写环境变量名称，不填写密钥本身。更改系统环境变量后需重启软件。'}" Style="{StaticResource SettingsHint}"/>
                    <Grid Margin="0,4" MinHeight="{DynamicResource UiParameterRowHeight}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Text Key='请求超时（10–600 秒）'}" Style="{StaticResource SettingsLabel}"/>
                        <TextBox Grid.Column="1" Text="{Binding AgentTimeoutSeconds, UpdateSourceTrigger=LostFocus}" Height="{DynamicResource UiInputHeight}" VerticalAlignment="Center"/>
                    </Grid>
                        <TextBlock Text="{loc:Text Key='系统提示词'}" Margin="0,8,0,4"/>
                        <TextBox Text="{Binding AgentSystemPrompt, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" TextWrapping="Wrap"
                                 Height="100" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                        <TextBlock Text="{loc:Text Key='支持 OpenAI 兼容 Chat Completions。默认地址用于本地 Ollama；配置模型后由发送按钮发起请求。'}" Style="{StaticResource SettingsHint}"/>
                    <TextBlock Text="{loc:Text Key='可用模型'}" Margin="0,8,0,4"/>
<ComboBox ItemsSource="{Binding Chat.Models}" SelectedItem="{Binding Chat.SelectedModel}" Margin="0,0,0,8"/>
<Button Content="{loc:Text Key='读取模型列表'}" Command="{Binding Chat.LoadModelsCommand}" Style="{StaticResource SecondaryActionButtonStyle}"/>
<TextBlock Text="{loc:LocalizedBinding Chat.Status}" TextWrapping="Wrap" Margin="0,4"/>
</StackPanel></Border>
<TextBlock Text="{loc:LocalizedBinding SaveStatus}" TextWrapping="Wrap"/><TextBox Text="{Binding SettingsLocation, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,8"/></StackPanel></UserControl>
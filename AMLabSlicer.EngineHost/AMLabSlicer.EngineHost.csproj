<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.34.1" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.76.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.76.0" />
    <PackageReference Include="Grpc.Tools" Version="2.80.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\Protos\slicer.proto" GrpcServices="Both" />
    <ProjectReference Include="../AMLabSlicer.Engine.Atom/AMLabSlicer.Engine.Atom.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="StageAtomRuntime" AfterTargets="Build">
    <ItemGroup><AtomRuntime Include="$(MSBuildThisFileDirectory)../AMLabSlicer.Engine.Atom/bin/$(Configuration)/package/**/*" /></ItemGroup>
    <Copy SourceFiles="@(AtomRuntime)" DestinationFiles="@(AtomRuntime->'$(TargetDir)engines/atom/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(AtomRuntime)" DestinationFiles="@(AtomRuntime->'$(MSBuildThisFileDirectory)bin/$(Configuration)/package/engines/atom/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="StageEngineHostRuntime" AfterTargets="Build" DependsOnTargets="StageAtomRuntime">
    <PropertyGroup>
      <EngineHostPackage>$(MSBuildThisFileDirectory)bin/$(Configuration)/package/</EngineHostPackage>
      <FdmRuntimeSource>$(MSBuildThisFileDirectory)../AMLabSlicer.Engine.FDM/build/Release/</FdmRuntimeSource>
    </PropertyGroup>
    <ItemGroup>
      <HostRuntimeFiles Include="$(TargetPath);$(TargetDir)$(AssemblyName).exe;$(TargetDir)$(AssemblyName).deps.json;$(TargetDir)$(AssemblyName).runtimeconfig.json"/>
      <HostRuntimeFiles Include="@(ReferenceCopyLocalPaths)"/>
      <FdmRuntimeFiles Include="$(FdmRuntimeSource)*.dll;$(FdmRuntimeSource)fdm_engine.exe"/>
    </ItemGroup>
    <Copy SourceFiles="@(HostRuntimeFiles)" DestinationFolder="$(EngineHostPackage)" SkipUnchangedFiles="true"/>
    <Copy SourceFiles="@(FdmRuntimeFiles)" DestinationFolder="$(EngineHostPackage)engines/fdm/" SkipUnchangedFiles="true"/>
    <Copy SourceFiles="@(FdmRuntimeFiles)" DestinationFolder="$(TargetDir)engines/fdm/" SkipUnchangedFiles="true"/>
    <ItemGroup>
      <EngineIdentityFiles Include="@(HostRuntimeFiles->'%(Filename)%(Extension)')" />
      <EngineIdentityFiles Include="@(FdmRuntimeFiles->'engines/fdm/%(Filename)%(Extension)')" />
      <EngineIdentityFiles Include="@(AtomRuntime->'engines/atom/%(RecursiveDir)%(Filename)%(Extension)')" />
    </ItemGroup>
    <WriteLinesToFile File="$(TargetDir)engine-runtime-manifest.txt" Lines="@(EngineIdentityFiles)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <Copy SourceFiles="$(TargetDir)engine-runtime-manifest.txt" DestinationFolder="$(EngineHostPackage)" SkipUnchangedFiles="true" />
  </Target>
  <ItemGroup><Compile Include="../Shared/OwnedProcessJob.cs" Link="Processes/OwnedProcessJob.cs" /></ItemGroup>
  <ItemGroup><Compile Include="../Shared/HostBuildIdentity.cs" Link="Processes/HostBuildIdentity.cs" /></ItemGroup>
</Project>

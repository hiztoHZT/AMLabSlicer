<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.34.1" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.76.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.76.0" />
    <PackageReference Include="Grpc.Tools" Version="2.80.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\Protos\slicer.proto" GrpcServices="Both" />
  </ItemGroup>
  <Target Name="StageEngineHostRuntime" AfterTargets="Build">
    <PropertyGroup>
      <EngineHostPackage>$(MSBuildThisFileDirectory)bin/$(Configuration)/package/</EngineHostPackage>
      <FdmRuntimeSource>$(MSBuildThisFileDirectory)../AMLabSlicer.Engine.FDM/build/Release/</FdmRuntimeSource>
    </PropertyGroup>
    <ItemGroup>
      <HostRuntimeFiles Include="$(TargetPath);$(TargetDir)$(AssemblyName).exe;$(TargetDir)$(AssemblyName).deps.json;$(TargetDir)$(AssemblyName).runtimeconfig.json"/>
      <HostRuntimeFiles Include="@(ReferenceCopyLocalPaths)"/>
      <FdmRuntimeFiles Include="$(FdmRuntimeSource)*.dll;$(FdmRuntimeSource)fdm_engine.exe"/>
    </ItemGroup>
    <Copy SourceFiles="@(HostRuntimeFiles)" DestinationFolder="$(EngineHostPackage)" SkipUnchangedFiles="true"/>
    <Copy SourceFiles="@(FdmRuntimeFiles)" DestinationFolder="$(EngineHostPackage)engines/fdm/" SkipUnchangedFiles="true"/>
  </Target>
</Project>

<UserControl x:Class="AMLabSlicer.Plugins.Tripo.TripoPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:AMLabSlicer.Plugin.Wpf.Localization;assembly=AMLabSlicer.Plugin.Wpf"
 FontFamily="{DynamicResource UiFontFamily}" FontSize="{DynamicResource UiFontSize}"
 Foreground="{DynamicResource PrimaryTextBrush}" Background="{DynamicResource SurfaceBrush}">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="8">
   <DockPanel MinHeight="{DynamicResource UiCardHeaderHeight}" Margin="0,0,0,8">
    <Button DockPanel.Dock="Right" Content="{loc:Text Key='设置'}" Command="{Binding SettingsCommand}"
            Style="{StaticResource SecondaryActionButtonStyle}"/>
    <TextBlock Text="Tripo AI" FontSize="{DynamicResource UiTitleFontSize}" VerticalAlignment="Center" FontWeight="SemiBold"/>
   </DockPanel>
   <TextBlock Text="{loc:Text Key='模型描述'}" Margin="0,0,0,4"/>
   <TextBox Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
            Height="90" Padding="8" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
            MaxLength="1024" Margin="0,0,0,8"/>
   <TextBlock Text="{loc:Text Key='图片 HTTPS URL（填写后使用图片生成）'}" TextWrapping="Wrap" Margin="0,0,0,4"/>
   <TextBox Text="{Binding ImageUrl, UpdateSourceTrigger=PropertyChanged}" MinHeight="{DynamicResource UiInputHeight}" Margin="0,0,0,8"/>
   <CheckBox IsChecked="{Binding AutoImport}" MinHeight="{DynamicResource UiParameterRowHeight}" Margin="0,0,0,8">
    <TextBlock Text="{loc:Text Key='生成后自动导入到视窗'}" TextWrapping="Wrap"/>
   </CheckBox>
   <Grid Margin="0,0,0,8">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button Command="{Binding GenerateCommand}" Style="{StaticResource PrimaryActionButtonStyle}" Height="Auto"
            MinHeight="{DynamicResource UiActionHeight}" Padding="10,4" Margin="0,0,8,0">
     <TextBlock Text="{loc:Text Key='生成模型（消耗积分）'}" TextWrapping="Wrap" TextAlignment="Center"/>
    </Button>
    <Button Grid.Column="1" Content="{loc:Text Key='停止等待'}" Command="{Binding GenerateCancelCommand}"
            Style="{StaticResource SecondaryActionButtonStyle}"/>
   </Grid>
   <TextBlock Text="{loc:LocalizedBinding Status}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
   <TextBox Text="{Binding LocalPath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
            VerticalContentAlignment="Top" MaxHeight="90" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
    <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
     <Style.Triggers><DataTrigger Binding="{Binding LocalPath}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
    </Style></TextBox.Style>
   </TextBox>
   <Button Content="{loc:Text Key='导入到视窗'}" Command="{Binding ImportCommand}"
           Style="{StaticResource SecondaryActionButtonStyle}" MinHeight="{DynamicResource UiActionHeight}"/>
  </StackPanel>
 </ScrollViewer>
</UserControl>

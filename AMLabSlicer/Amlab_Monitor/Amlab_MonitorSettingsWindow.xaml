<views:ThemedWindow x:Class="AMLabSlicer.Amlab_Monitor.Amlab_MonitorSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:AMLabSlicer.Views"
    xmlns:loc="clr-namespace:AMLabSlicer.Plugin.Wpf.Localization;assembly=AMLabSlicer.Plugin.Wpf"
    Title="{loc:Text Key='缺陷检测配置'}" Width="760" Height="410" MinWidth="660" MinHeight="370"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
    FontFamily="{DynamicResource UiFontFamily}" FontSize="{DynamicResource UiFontSize}">
    <views:ThemedWindow.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource SecondaryActionButtonStyle}"/>
    </views:ThemedWindow.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="{loc:Text Key='添加权重…'}" Command="{Binding Amlab_MonitorAddModelCommand}"/>
            <TextBlock Text="{loc:Text Key='视觉模型'}" FontWeight="SemiBold"
                       FontSize="{DynamicResource UiTitleFontSize}" VerticalAlignment="Center"/>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource SettingsCardStyle}" Padding="{StaticResource UiCardPadding}" Margin="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{loc:Text Key='自定义权重'}" FontWeight="SemiBold"
                               MinHeight="{DynamicResource UiCardHeaderHeight}"/>
                    <ListBox ItemsSource="{Binding Amlab_MonitorEntries}" SelectedItem="{Binding Amlab_MonitorSelectedEntry}"
                             Style="{StaticResource SectionNavigationStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="{loc:Text Key='自定义权重'}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource SettingsCardStyle}" Padding="{StaticResource UiCardPadding}" Margin="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="{loc:Text Key='添加可信来源的 YOLO .pt 权重。兼容性在首次检测时检查。'}"
                                   Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <StackPanel IsEnabled="{Binding Amlab_MonitorHasSelection}">
                            <TextBlock Text="{loc:Text Key='模型名称'}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding Amlab_MonitorSelectedEntry.Name, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="{loc:Text Key='模型名称'}" Margin="0,0,0,8"/>
                            <TextBlock Text="{loc:Text Key='权重文件'}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding Amlab_MonitorSelectedEntry.WeightPath, Mode=OneWay}" IsReadOnly="True"
                                     AutomationProperties.Name="{loc:Text Key='权重文件'}"
                                     ToolTip="{Binding Amlab_MonitorSelectedEntry.WeightPath}" Margin="0,0,0,8"/>
                            <WrapPanel>
                                <Button Content="{loc:Text Key='更换权重…'}" Command="{Binding Amlab_MonitorChangeWeightCommand}" Margin="0,0,8,4"/>
                                <Button Content="{loc:Text Key='移除模型'}" Command="{Binding Amlab_MonitorRemoveModelCommand}" Margin="0,0,0,4"/>
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding Amlab_MonitorStatus}" Foreground="{DynamicResource WarningBrush}"
                   TextWrapping="Wrap" Margin="0,4,0,0"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="{loc:Text Key='取消'}" IsCancel="True" MinWidth="78" Margin="0,0,8,0"/>
            <Button Content="{loc:Text Key='保存'}" Command="{Binding Amlab_MonitorSaveCommand}" IsDefault="True" MinWidth="78"
                    Style="{StaticResource PrimaryActionButtonStyle}"/>
        </StackPanel>
    </Grid>
</views:ThemedWindow>

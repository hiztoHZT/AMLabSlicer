<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <FontFamily x:Key="UiFontFamily">Microsoft YaHei</FontFamily>
    <sys:Double x:Key="UiFontSize">12</sys:Double>
    <sys:Double x:Key="UiTitleFontSize">13</sys:Double>
    <sys:Double x:Key="UiSmallFontSize">11</sys:Double>
    <SolidColorBrush x:Key="ParameterSliderTrackBrush" Color="#151515"/>
    <SolidColorBrush x:Key="ParameterSliderFillBrush" Color="#666666"/>
    <SolidColorBrush x:Key="ParameterSliderThumbBrush" Color="#D9D9D9"/>
    <!-- Shared UI tokens: docs/UI_DESIGN_STANDARD.md -->
    <CornerRadius x:Key="UiCornerRadius">5</CornerRadius>
    <CornerRadius x:Key="UiLeftPanelCornerRadius">5,0,0,5</CornerRadius>
    <CornerRadius x:Key="UiViewportCornerRadius">0,5,5,0</CornerRadius>
    <sys:Double x:Key="UiInputHeight">26</sys:Double>
    <sys:Double x:Key="UiParameterRowHeight">32</sys:Double>
    <sys:Double x:Key="UiParameterPanelMinHeight">150</sys:Double>
    <sys:Double x:Key="UiCardHeaderHeight">30</sys:Double>
    <sys:Double x:Key="UiActionHeight">30</sys:Double>
    <sys:Double x:Key="UiNavigationHeight">30</sys:Double>
    <sys:Double x:Key="UiConfigRowHeight">36</sys:Double>
    <GridLength x:Key="UiConfigRowGridHeight">36</GridLength>
    <sys:Double x:Key="UiCategoryItemHeight">28</sys:Double>
    <sys:Double x:Key="UiInlineInputHeight">24</sys:Double>
    <sys:Double x:Key="UiFoldButtonSize">20</sys:Double>
    <Thickness x:Key="UiCardPadding">8</Thickness>
    <Thickness x:Key="UiWorkspaceMargin">4</Thickness>
    <Thickness x:Key="UiCardContentPadding">8,0,8,8</Thickness>
    <Thickness x:Key="UiCardCollapsedPadding">8,0</Thickness>
    <Thickness x:Key="UiCardMargin">8,0,8,8</Thickness>
    <Thickness x:Key="UiInputPadding">6,1</Thickness>
    <SolidColorBrush x:Key="ControlHoverBorderBrush" Color="#666666"/>

    <!-- ════════════════════════════════════════════ -->
    <!--               Color Palette                 -->
    <!-- ════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="SelectionHighlightBrush" Color="#203B56" />
    <Color x:Key="PrimaryTextColor">#E6E6E6</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#252525" />
    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#252525" />
    <SolidColorBrush x:Key="ViewportBackgroundBrush" Color="#333333" />
    <Color x:Key="BuildGridMinorColor">#4D4D4D</Color>
    <Color x:Key="BuildGridMajorColor">#666666</Color>
    <SolidColorBrush x:Key="ViewCubeTextBrush" Color="#C1C7D0"/>
    <SolidColorBrush x:Key="ViewCubeStrokeBrush" Color="#A6AFBD"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#424242" />
    <SolidColorBrush x:Key="OverlayPanelBrush" Color="#D01A1A1A" />

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#E6E6E6" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A6A6A6" />

    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#383838" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="CloseButtonHoverBrush" Color="#E81123" />

    <SolidColorBrush x:Key="MenuPopupBackgroundBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="MenuPopupBorderBrush" Color="#424242" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="#383838" />
    <SolidColorBrush x:Key="MenuItemTextBrush" Color="#E6E6E6" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="#424242" />

    <SolidColorBrush x:Key="GridSplitterBrush" Color="#252525" />
    <SolidColorBrush x:Key="SplitterTrackBrush" Color="#252525" />
    <SolidColorBrush x:Key="SplitterHandleBrush" Color="#666666" />

    <!-- 控件用色 -->
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#323232" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#424242" />
    <SolidColorBrush x:Key="ControlFocusBorderBrush" Color="#2D9BFF" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2D9BFF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#47A9FF" />
    <SolidColorBrush x:Key="MutedAccentBrush" Color="#203B56" />
    <SolidColorBrush x:Key="ExpanderHeaderBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="MenuItemBackgroundBrush" Color="#2B2B2B" />

    <!-- ════════════════════════════════════════════ -->
    <!--           Window Button Styles              -->
    <!-- ════════════════════════════════════════════ -->
    <Style x:Key="WindowButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource CloseButtonHoverBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════════════════════════════════ -->
    <!--         Menu / MenuItem (VS Code 风格)       -->
    <!-- ════════════════════════════════════════════ -->
    <Style TargetType="Menu">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- Separator in menu -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="28,4,8,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Background="{DynamicResource MenuSeparatorBrush}" Height="1"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 顶层含子菜单 (文件 / 设置) ── -->
    <Style x:Key="TopLevelHeaderStyle" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource MenuItemTextBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource UiFontSize}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="Bd" Background="Transparent" Padding="10,5" CornerRadius="{StaticResource UiCornerRadius}">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                        </Border>
                        <Popup x:Name="PART_Popup" 
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" 
                               Placement="Bottom" AllowsTransparency="True" Focusable="False"
                               PopupAnimation="Fade" HorizontalOffset="-1">
                            <Border Background="{DynamicResource MenuPopupBackgroundBrush}" 
                                    BorderBrush="{DynamicResource MenuPopupBorderBrush}" 
                                    BorderThickness="1" Padding="4" CornerRadius="{StaticResource UiCornerRadius}"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MenuPopupBackgroundBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 子菜单普通项 ── -->
    <Style x:Key="SubmenuItemStyle" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource MenuItemTextBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource UiFontSize}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="28,7,20,7" MinWidth="180" CornerRadius="{StaticResource UiCornerRadius}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="HeaderHost" Grid.Column="0" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                            <TextBlock x:Name="InputGestureText" Grid.Column="1" Text="{TemplateBinding InputGestureText}" 
                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="{DynamicResource UiFontSize}"
                                       Margin="30,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MenuItemHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════════════════════════════════ -->
    <!--           全局暗色 TextBox 样式              -->
    <!-- ════════════════════════════════════════════ -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="{StaticResource UiInputPadding}"/>
        <Setter Property="MinHeight" Value="{DynamicResource UiInputHeight}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CaretBrush" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource UiFontSize}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="{StaticResource UiCornerRadius}" SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ControlHoverBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ControlFocusBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════════════════════════════════ -->
    <!--       全局暗色 ComboBox 完整模板              -->
    <!-- ════════════════════════════════════════════ -->
    <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="20"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="Border" Grid.ColumnSpan="2" CornerRadius="{StaticResource UiCornerRadius}"
                    Background="{DynamicResource ControlBackgroundBrush}" 
                    BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"/>
            <Path x:Name="Arrow" Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z"
                  Fill="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource ControlHoverBorderBrush}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="{DynamicResource UiInputHeight}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource UiFontSize}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid x:Name="ComboRoot">
                        <ToggleButton Template="{StaticResource ComboBoxToggleButton}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Focusable="False" ClickMode="Press"/>
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="6,1,24,1"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Stretch"
                                          ClipToBounds="True"/>
                        <Border x:Name="FocusBorder" IsHitTestVisible="False" Visibility="Collapsed"
                                BorderBrush="{DynamicResource ControlFocusBorderBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource UiCornerRadius}"/>
                        <Popup x:Name="Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                            <Border x:Name="DropDown" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{DynamicResource MenuPopupBackgroundBrush}" 
                                    BorderBrush="{DynamicResource MenuPopupBorderBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource UiCornerRadius}"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FocusBorder" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ComboRoot" Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="{StaticResource UiCornerRadius}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MenuItemHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════════════════════════════════ -->
    <!--          全局暗色 CheckBox 样式              -->
    <!-- ════════════════════════════════════════════ -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource UiFontSize}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="Box" Width="16" Height="16" CornerRadius="4"
                                Background="{DynamicResource ControlBackgroundBrush}" 
                                BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                                VerticalAlignment="Center">
                            <Path x:Name="Check" Data="M 2 5 L 5.5 9 L 12 2" Stroke="White" StrokeThickness="2"
                                  Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ContentPresenter x:Name="CheckBoxContent" Margin="6,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="CheckBoxContent" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource ControlFocusBorderBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════════════════════════════════ -->
    <!--          全局暗色 Slider 样式                -->
    <!-- ════════════════════════════════════════════ -->
    <Style TargetType="Slider">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
    </Style>

    <!-- ════════════════════════════════════════════ -->
    <!--   暗色 Expander (Blender 可折叠分组)         -->
    <!-- ════════════════════════════════════════════ -->
    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <DockPanel>
                        <ToggleButton x:Name="HeaderToggle" DockPanel.Dock="Top" 
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Cursor="Hand" Focusable="False">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="HeaderBd" Background="{DynamicResource ExpanderHeaderBrush}" 
                                            CornerRadius="{StaticResource UiCornerRadius}" Height="{DynamicResource UiCardHeaderHeight}" Padding="8,0" Margin="0,2,0,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path x:Name="Arrow" Data="M 0 0 L 5 4 L 0 8 Z" 
                                                  Fill="{DynamicResource SecondaryTextBrush}" 
                                                  VerticalAlignment="Center" Margin="0,0,8,0"
                                                  RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform>
                                                    <RotateTransform Angle="0"/>
                                                </Path.RenderTransform>
                                            </Path>
                                            <ContentPresenter ContentSource="Content" 
                                                              TextBlock.FontWeight="SemiBold" 
                                                              TextBlock.FontSize="{DynamicResource UiFontSize}"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Arrow" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="90"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="HeaderBd" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <ContentPresenter ContentSource="Header"/>
                        </ToggleButton>
                        <Border x:Name="ContentBd" Visibility="Collapsed" Padding="4,4,4,8">
                            <ContentPresenter/>
                        </Border>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ContentBd" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WorkspacePanelBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="WorkspaceViewportBorderStyle" TargetType="Border" BasedOn="{StaticResource WorkspacePanelBorderStyle}">
        <Setter Property="Background" Value="{DynamicResource ViewportBackgroundBrush}"/>
    </Style>

    <Style x:Key="WorkspaceNavButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="{DynamicResource UiNavigationHeight}"/>
        <Setter Property="MinWidth" Value="110"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Margin" Value="2,3"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="{DynamicResource UiFontSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource UiCornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="active">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MutedAccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Geometry x:Key="PanelRightIconGeometry">M3 6 A2 2 0 0 1 5 4 H19 A2 2 0 0 1 21 6 V18 A2 2 0 0 1 19 20 H5 A2 2 0 0 1 3 18 Z M15 4 V20</Geometry>
    <Geometry x:Key="PanelLeftIconGeometry">M3 6 A2 2 0 0 1 5 4 H19 A2 2 0 0 1 21 6 V18 A2 2 0 0 1 19 20 H5 A2 2 0 0 1 3 18 Z M9 4 V20</Geometry>

    <Style x:Key="SidebarToggleButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="{DynamicResource UiNavigationHeight}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="ToolTip" Value="展开/收起参数面板"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource UiCornerRadius}">
                        <Path x:Name="Icon"
                              Width="16"
                              Height="16"
                              Stretch="Uniform"
                              Data="{StaticResource PanelLeftIconGeometry}"
                              Stroke="{TemplateBinding Foreground}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Fill="Transparent"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Icon" Property="Opacity" Value="0.75"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="{DynamicResource UiActionHeight}"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="{DynamicResource UiFontSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource UiCornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WorkspaceVerticalSplitterStyle" TargetType="GridSplitter">
        <Setter Property="Width" Value="4"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="ShowsPreview" Value="False"/>
        <Setter Property="Cursor" Value="SizeWE"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Grid Background="{TemplateBinding Background}">
                        <Border x:Name="Track"
                                Width="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Stretch"
                                Background="Transparent"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Width" Value="4"/>
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource SplitterHandleBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WorkspaceHorizontalSplitterStyle" TargetType="GridSplitter">
        <Setter Property="Height" Value="4"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="ShowsPreview" Value="False"/>
        <Setter Property="Cursor" Value="SizeNS"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Grid Background="{TemplateBinding Background}">
                        <Border x:Name="Track"
                                Height="1"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Background="Transparent"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Height" Value="4"/>
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource SplitterHandleBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style x:Key="SettingsCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource UiCornerRadius}"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="SecondaryActionButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="{DynamicResource UiInputHeight}"/>
        <Setter Property="Padding" Value="10,2"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="{DynamicResource UiFontSize}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource UiCornerRadius}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource ControlFocusBorderBrush}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SectionNavigationStyle" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="10,8"/>
                    <Setter Property="Margin" Value="0,0,0,4"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="ItemBorder" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="{StaticResource UiCornerRadius}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/></Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MutedAccentBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ExtensionRailButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="28"/><Setter Property="Height" Value="30"/>
        <Setter Property="Margin" Value="0,0,0,4"/><Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource UiTitleFontSize}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="RailButton" Background="{TemplateBinding Background}" CornerRadius="{StaticResource UiCornerRadius}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="Tag"><Trigger.Value><sys:Boolean>True</sys:Boolean></Trigger.Value><Setter TargetName="RailButton" Property="Background" Value="{DynamicResource MutedAccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RailButton" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#666666"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#888888"/>
    <SolidColorBrush x:Key="ScrollThumbDraggingBrush" Color="#AAAAAA"/>
    <ControlTemplate x:Key="ScrollPageButtonTemplate" TargetType="RepeatButton">
        <Border Background="Transparent"/>
    </ControlTemplate>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True"
                               Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                               ViewportSize="{TemplateBinding ViewportSize}"
                               Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton x:Name="DecreasePage" Command="ScrollBar.PageUpCommand" Focusable="False" Template="{StaticResource ScrollPageButtonTemplate}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="ScrollThumb" MinHeight="24">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ThumbBody" Margin="3,2" Background="{DynamicResource ScrollThumbBrush}" CornerRadius="5"/>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="Horizontal">
                                                    <Setter TargetName="ThumbBody" Property="Margin" Value="2,3"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbBody" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}"/></Trigger>
                                                <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbBody" Property="Background" Value="{DynamicResource ScrollThumbDraggingBrush}"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton x:Name="IncreasePage" Command="ScrollBar.PageDownCommand" Focusable="False" Template="{StaticResource ScrollPageButtonTemplate}"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            <Setter TargetName="DecreasePage" Property="Command" Value="ScrollBar.PageLeftCommand"/>
                            <Setter TargetName="IncreasePage" Property="Command" Value="ScrollBar.PageRightCommand"/>
                            <Setter TargetName="ScrollThumb" Property="MinHeight" Value="0"/>
                            <Setter TargetName="ScrollThumb" Property="MinWidth" Value="24"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ScrollThumb" Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal"><Setter Property="Height" Value="12"/><Setter Property="Width" Value="Auto"/></Trigger>
        </Style.Triggers>
    </Style>
    <SolidColorBrush x:Key="WarningBrush" Color="#E0A642"/>
    <Style x:Key="ThemedWindowStyle" TargetType="Window">
        <Setter Property="WindowStyle" Value="None"/>
        <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource UiFontSize}"/>
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value><WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/></Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <!-- Fill the opaque HWND behind anti-aliased rounded edges with the theme, not black. -->
                    <Grid Background="{TemplateBinding Background}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource UiCornerRadius}">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border Background="{DynamicResource TitleBarBackgroundBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="0,0,0,1" CornerRadius="5,5,0,0">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Width="36" Content="✕" Style="{StaticResource CloseButtonStyle}"
                                            WindowChrome.IsHitTestVisibleInChrome="True" Command="{x:Static SystemCommands.CloseWindowCommand}"
                                            CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" ToolTip="关闭"/>
                                    <TextBlock Text="{TemplateBinding Title}" Margin="12,0" FontSize="{DynamicResource UiTitleFontSize}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <AdornerDecorator Grid.Row="1"><ContentPresenter/></AdornerDecorator>
                        </Grid>
                    </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
	  <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Assets\新文件夹\**" />
    <EmbeddedResource Remove="Assets\新文件夹\**" />
    <None Remove="Assets\新文件夹\**" />
    <Page Remove="Assets\新文件夹\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\Images\AMLab_logo_rgb.svg" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\ico\AMLAS.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="HelixToolkit.SharpDX.Assimp" Version="3.1.2" />
    <PackageReference Include="HelixToolkit.Wpf.SharpDX" Version="3.1.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0-preview.2.26159.112" />
    <PackageReference Include="SharpVectors" Version="1.8.5" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Images\AMLab_logo_rgb.svg" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AMLabSlicer.Core\AMLabSlicer.Core.csproj" />
    <ProjectReference Include="..\AMLabSlicer.Slicing\AMLabSlicer.Slicing.csproj" />
  </ItemGroup>

  <!-- 将 AMLabSlicer.Engine.dll 及 OCCT 运行时 DLL 复制到输出目录 -->
  <PropertyGroup>
    <EngineOutputDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\AMLabSlicer.Engine\x64\$(Configuration)\'))</EngineOutputDir>
    <NuGetAuditMode>all</NuGetAuditMode>
    <ApplicationIcon>Assets\ico\AMLAS.ico</ApplicationIcon>
  </PropertyGroup>
  
  <Target Name="CopyNativeEngine" AfterTargets="Build">
    <ItemGroup>
      <NativeEngineFiles Include="$(EngineOutputDir)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(NativeEngineFiles)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="Exists('$(EngineOutputDir)')" />
    <Message Text="Copied native engine DLLs from $(EngineOutputDir)" Importance="high" Condition="Exists('$(EngineOutputDir)')" />
    <Warning Text="Native engine output not found at $(EngineOutputDir). Build AMLabSlicer.Engine (x64) first." Condition="!Exists('$(EngineOutputDir)')" />
  </Target>

</Project>


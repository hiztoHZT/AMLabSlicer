<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
	  <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Assets\鏂版枃浠跺す\**" />
    <EmbeddedResource Remove="Assets\鏂版枃浠跺す\**" />
    <None Remove="Assets\鏂版枃浠跺す\**" />
    <Page Remove="Assets\鏂版枃浠跺す\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\Images\AMLab_logo_rgb.svg" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\ico\AMLAS.ico" />
    <Content Include="Extensions\README.md" Link="extensions\README.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Google.Protobuf" Version="3.34.1" />
    <PackageReference Include="Grpc.Net.Client" Version="2.76.0" />
    <PackageReference Include="Grpc.Tools" Version="2.80.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="HelixToolkit.SharpDX.Assimp" Version="3.1.2" />
    <PackageReference Include="HelixToolkit.Wpf.SharpDX" Version="3.1.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="SharpVectors" Version="1.8.5" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\Protos\slicer.proto" GrpcServices="Client" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Images\AMLab_logo_rgb.svg" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AMLabSlicer.Plugin.Wpf/AMLabSlicer.Plugin.Wpf.csproj"/>
    <ProjectReference Include="../AMLabSlicer.Plugins.Agent/AMLabSlicer.Plugins.Agent.csproj" ReferenceOutputAssembly="false"/>
    <ProjectReference Include="../AMLabSlicer.EngineHost/AMLabSlicer.EngineHost.csproj" ReferenceOutputAssembly="false"/>
    <ProjectReference Include="..\AMLabSlicer.Core\AMLabSlicer.Core.csproj" />
    <ProjectReference Include="..\AMLabSlicer.Occt\AMLabSlicer.Occt.csproj" />
  </ItemGroup>

  <!-- 灏?AMLabSlicer.Engine.dll 鍙?OCCT 杩愯鏃?DLL 澶嶅埗鍒拌緭鍑虹洰褰?-->
  <PropertyGroup>
    <EngineOutputDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\x64\$(Configuration)\'))</EngineOutputDir>
    <NuGetAuditMode>all</NuGetAuditMode>
    <ApplicationIcon>Assets\ico\AMLAS.ico</ApplicationIcon>
  </PropertyGroup>
  
  <Target Name="CopyNativeEngine" AfterTargets="Build">
    <ItemGroup>
      <NativeEngineFiles Include="$(EngineOutputDir)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(NativeEngineFiles)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="Exists('$(EngineOutputDir)')" />
    <Message Text="Copied native engine DLLs from $(EngineOutputDir)" Importance="high" Condition="Exists('$(EngineOutputDir)')" />
    <Warning Text="Native engine output not found at $(EngineOutputDir). Build AMLabSlicer.Occt.Native (x64) first." Condition="!Exists('$(EngineOutputDir)')" />
  </Target>

  <Target Name="CopyAgentPlugin" AfterTargets="Build">
    <PropertyGroup><AgentPackageSource>$(MSBuildThisFileDirectory)../AMLabSlicer.Plugins.Agent/bin/$(Configuration)/package/</AgentPackageSource></PropertyGroup>
    <ItemGroup><AgentPackage Include="$(AgentPackageSource)**/*"/></ItemGroup>
    <Copy SourceFiles="@(AgentPackage)" DestinationFiles="@(AgentPackage->'$(TargetDir)extensions/amlab.agent/1.0.0/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true"/>
  </Target>
  <Target Name="PublishAgentPlugin" AfterTargets="Publish">
    <ItemGroup><AgentPublishPackage Include="$(MSBuildThisFileDirectory)../AMLabSlicer.Plugins.Agent/bin/$(Configuration)/package/**/*"/></ItemGroup>
    <Copy SourceFiles="@(AgentPublishPackage)" DestinationFiles="@(AgentPublishPackage->'$(PublishDir)extensions/amlab.agent/1.0.0/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true"/>
  </Target>
  <Target Name="CopyEngineHostRuntime" AfterTargets="Build">
    <ItemGroup><EngineHostRuntime Include="$(MSBuildThisFileDirectory)../AMLabSlicer.EngineHost/bin/$(Configuration)/package/**/*"/></ItemGroup>
    <Copy SourceFiles="@(EngineHostRuntime)" DestinationFiles="@(EngineHostRuntime->'$(TargetDir)enginehost/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true"/>
  </Target>
  <Target Name="PublishEngineHostRuntime" AfterTargets="Publish">
    <ItemGroup><EngineHostPublishRuntime Include="$(MSBuildThisFileDirectory)../AMLabSlicer.EngineHost/bin/$(Configuration)/package/**/*"/></ItemGroup>
    <Copy SourceFiles="@(EngineHostPublishRuntime)" DestinationFiles="@(EngineHostPublishRuntime->'$(PublishDir)enginehost/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true"/>
  </Target>
</Project>


<views:ThemedWindow x:Class="AMLabSlicer.Views.PresetNameWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:AMLabSlicer.Views" Width="420" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <StackPanel Margin="16">
  <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,10"/>
  <TextBox x:Name="NameInput" Height="{DynamicResource UiInputHeight}" MaxLength="80" Margin="0,0,0,12"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="取消" IsCancel="True" Style="{StaticResource SecondaryActionButtonStyle}" Margin="0,0,8,0"/>
   <Button Content="确定" IsDefault="True" Click="Accept_Click" Style="{StaticResource PrimaryActionButtonStyle}"/>
  </StackPanel>
 </StackPanel>
</views:ThemedWindow>
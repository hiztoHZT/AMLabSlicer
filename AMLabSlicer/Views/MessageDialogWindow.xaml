<views:ThemedWindow x:Class="AMLabSlicer.Views.MessageDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:AMLabSlicer.Plugin.Wpf.Localization;assembly=AMLabSlicer.Plugin.Wpf"
    xmlns:views="clr-namespace:AMLabSlicer.Views" Width="440" SizeToContent="Height" MinHeight="170" MaxHeight="600"
    ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="MessageIcon" Text="i" FontSize="24" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top"/>
            <ScrollViewer Grid.Column="1" MaxHeight="420" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,4,0,12"/>
            </ScrollViewer>
        </Grid>
        <Button Grid.Row="1" Content="{loc:Text Key='确定'}" IsDefault="True" HorizontalAlignment="Right" MinWidth="72"
                Style="{StaticResource PrimaryActionButtonStyle}" Click="Confirm_Click"/>
    </Grid>
</views:ThemedWindow>

<UserControl x:Class="AMLabSlicer.Views.ParameterPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:AMLabSlicer.Views"
             xmlns:selectors="clr-namespace:AMLabSlicer.Selectors"
             MinWidth="280"
             FontSize="12"
             mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <views:MinWidthToVisibilityConverter x:Key="MinWidthToVisibility"/>
        <views:AlgorithmDisplayNameConverter x:Key="AlgorithmDisplayName"/>
        <SolidColorBrush x:Key="ParameterSliderTrackBrush" Color="#151515"/>
        <SolidColorBrush x:Key="ParameterSliderFillBrush" Color="#666666"/>
        <SolidColorBrush x:Key="ParameterSliderThumbBrush" Color="#D9D9D9"/>

        <ControlTemplate x:Key="ParameterSliderTrackButtonTemplate" TargetType="{x:Type RepeatButton}">
            <Border Height="4"
                    VerticalAlignment="Center"
                    Background="{TemplateBinding Background}"
                    CornerRadius="2"/>
        </ControlTemplate>

        <ControlTemplate x:Key="ParameterSliderThumbTemplate" TargetType="{x:Type Thumb}">
            <Ellipse x:Name="Grip"
                     Width="14"
                     Height="14"
                     Fill="{DynamicResource ParameterSliderThumbBrush}"
                     Stroke="{DynamicResource SurfaceBorderBrush}"
                     StrokeThickness="1"/>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Grip" Property="Fill" Value="White"/>
                    <Setter TargetName="Grip" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="CategoryScrollButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CategoryTabButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="54"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SubcategoryToggleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ParameterRowLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="ParameterUnitTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="2,0,8,0"/>
        </Style>

        <Style x:Key="ParameterValueFieldStyle" TargetType="Border">
            <Setter Property="Width" Value="118"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ParameterInlineTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ParameterValueTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Width" Value="170"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ParameterComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Width" Value="170"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="SlicingAlgorithmComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="ParameterSliderStyle" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
            <Setter Property="Width" Value="128"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid Height="22" VerticalAlignment="Center">
                            <Track x:Name="PART_Track"
                                   VerticalAlignment="Center"
                                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge"
                                                  Background="{DynamicResource ParameterSliderFillBrush}"
                                                  Focusable="False"
                                                  Template="{StaticResource ParameterSliderTrackButtonTemplate}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge"
                                                  Background="{DynamicResource ParameterSliderTrackBrush}"
                                                  Focusable="False"
                                                  Template="{StaticResource ParameterSliderTrackButtonTemplate}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14"
                                           Height="14"
                                           Focusable="False"
                                           Template="{StaticResource ParameterSliderThumbTemplate}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <selectors:ParameterTemplateSelector x:Key="ParamSelector">
            <selectors:ParameterTemplateSelector.TplCheckBox>
                <DataTemplate>
                    <Grid Margin="10,4" MinHeight="28" ToolTip="{Binding Description}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="0"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource ParameterRowLabelStyle}"/>
                        <CheckBox Grid.Column="1"
                                  IsChecked="{Binding Value}"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Right"
                                  Margin="12,0,2,0"/>
                    </Grid>
                </DataTemplate>
            </selectors:ParameterTemplateSelector.TplCheckBox>

            <selectors:ParameterTemplateSelector.TplNumericBox>
                <DataTemplate>
                    <Grid Margin="10,4" MinHeight="28" ToolTip="{Binding Description}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="0"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource ParameterRowLabelStyle}"/>
                        <Border Grid.Column="1"
                                Style="{StaticResource ParameterValueFieldStyle}"
                                HorizontalAlignment="Right"
                                Margin="12,0,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ParameterInlineTextBoxStyle}"
                                         LostKeyboardFocus="BoundedNumericTextBox_LostKeyboardFocus"
                                         KeyDown="BoundedNumericTextBox_KeyDown"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Unit}"
                                           Style="{StaticResource ParameterUnitTextStyle}"
                                           Visibility="{Binding Unit, Converter={x:Static views:NullToCollapsedConverter.Instance}}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </selectors:ParameterTemplateSelector.TplNumericBox>

            <selectors:ParameterTemplateSelector.TplSlider>
                <DataTemplate>
                    <Grid x:Name="SliderRow" Margin="10,4" MinHeight="28" ToolTip="{Binding Description}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="0"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource ParameterRowLabelStyle}"/>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="12,0,0,0">
                            <Slider Minimum="{Binding MinValue}" Maximum="{Binding MaxValue}"
                                    Value="{Binding Value}"
                                    Style="{StaticResource ParameterSliderStyle}"
                                    Visibility="{Binding ActualWidth, ElementName=SliderRow, Converter={StaticResource MinWidthToVisibility}, ConverterParameter=330}"
                                    TickFrequency="1" IsSnapToTickEnabled="False"/>
                            <Border Style="{StaticResource ParameterValueFieldStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F1}}"
                                             Style="{StaticResource ParameterInlineTextBoxStyle}"
                                             LostKeyboardFocus="BoundedNumericTextBox_LostKeyboardFocus"
                                             KeyDown="BoundedNumericTextBox_KeyDown"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Unit}"
                                               Style="{StaticResource ParameterUnitTextStyle}"
                                               Visibility="{Binding Unit, Converter={x:Static views:NullToCollapsedConverter.Instance}}"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </selectors:ParameterTemplateSelector.TplSlider>

            <selectors:ParameterTemplateSelector.TplComboBox>
                <DataTemplate>
                    <Grid Margin="10,4" MinHeight="28" ToolTip="{Binding Description}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="0"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource ParameterRowLabelStyle}"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Options}"
                                  SelectedItem="{Binding Value}"
                                  Style="{StaticResource ParameterComboBoxStyle}"
                                  HorizontalAlignment="Right"
                                  Margin="12,0,0,0"
                                  VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </selectors:ParameterTemplateSelector.TplComboBox>

            <selectors:ParameterTemplateSelector.TplTextBox>
                <DataTemplate>
                    <Grid Margin="10,4" MinHeight="28" ToolTip="{Binding Description}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="0"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource ParameterRowLabelStyle}"/>
                        <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ParameterValueTextBoxStyle}"
                                 HorizontalAlignment="Right"
                                 Margin="12,0,0,0"
                                 VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </selectors:ParameterTemplateSelector.TplTextBox>
        </selectors:ParameterTemplateSelector>
    </UserControl.Resources>

    <Border Background="{DynamicResource SurfaceBrush}"
            CornerRadius="0"
            ClipToBounds="True">
            <DockPanel>
            <Border DockPanel.Dock="Top"
                    Margin="8,8,8,4"
                    Padding="8,5"
                    Background="{DynamicResource SurfaceElevatedBrush}"
                    BorderBrush="{DynamicResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="切片配置" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="2,0,8,0"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding SlicingAlgorithms}"
                          Style="{StaticResource SlicingAlgorithmComboBoxStyle}"
                          HorizontalAlignment="Stretch"
                          SelectedItem="{Binding SelectedAlgorithm, UpdateSourceTrigger=PropertyChanged}"
                          ToolTip="{Binding SelectedAlgorithm, Converter={StaticResource AlgorithmDisplayName}}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource AlgorithmDisplayName}}"
                                       TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
            </Border>

            <Grid DockPanel.Dock="Top" Height="34" Background="{DynamicResource SurfaceElevatedBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="&lt;" Style="{StaticResource CategoryScrollButtonStyle}"
                        Click="ScrollCategoriesLeft_Click"/>
                <ScrollViewer x:Name="CategoryScrollViewer"
                              Grid.Column="1"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              CanContentScroll="False"
                              PreviewMouseWheel="CategoryScrollViewer_PreviewMouseWheel">
                    <ItemsControl ItemsSource="{Binding ParameterCategories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}"
                                        Style="{StaticResource CategoryTabButtonStyle}"
                                        Command="{Binding DataContext.SelectParameterCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Button Grid.Column="2" Content="&gt;" Style="{StaticResource CategoryScrollButtonStyle}"
                        Click="ScrollCategoriesRight_Click"/>
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4,0,8" Background="Transparent">
                <ItemsControl ItemsSource="{Binding SelectedParameterCategory.Subcategories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Border BorderBrush="{DynamicResource SurfaceBorderBrush}"
                                        BorderThickness="1"
                                        Background="{DynamicResource SurfaceElevatedBrush}"
                                        CornerRadius="8"
                                        Margin="8,5,8,0"
                                        Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="1"
                                                Content="{Binding ToggleText}"
                                                Command="{Binding ToggleCommand}"
                                                Style="{StaticResource SubcategoryToggleButtonStyle}"
                                                ToolTip="展开/收起"/>
                                    </Grid>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Parameters}"
                                              ItemTemplateSelector="{StaticResource ParamSelector}"
                                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            </DockPanel>
    </Border>
</UserControl>

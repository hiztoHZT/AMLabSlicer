<UserControl x:Class="AMLabSlicer.Views.ParameterPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:AMLabSlicer.Views"
             xmlns:selectors="clr-namespace:AMLabSlicer.Selectors"
             xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
             MinWidth="280"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- ═══ 分组排序 ═══ -->
        <CollectionViewSource x:Key="GroupedParams" Source="{Binding Parameters}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Category"/>
            </CollectionViewSource.GroupDescriptions>
            <CollectionViewSource.SortDescriptions>
                <scm:SortDescription PropertyName="Category"/>
                <scm:SortDescription PropertyName="DisplayName"/>
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>

        <!-- ═══ Phase 3: XAML 数据模板与分发器 ═══ -->
        <selectors:ParameterTemplateSelector x:Key="ParamSelector">

            <!-- CheckBox 模板 -->
            <selectors:ParameterTemplateSelector.TplCheckBox>
                <DataTemplate>
                    <Grid Margin="4,3" ToolTip="{Binding Description}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" 
                                   Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                        <CheckBox Grid.Column="1" IsChecked="{Binding Value}" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </selectors:ParameterTemplateSelector.TplCheckBox>

            <!-- NumericBox (带单位左对齐数字输入) 模板 -->
            <selectors:ParameterTemplateSelector.TplNumericBox>
                <DataTemplate>
                    <Grid Margin="4,3" ToolTip="{Binding Description}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" 
                                   Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" 
                                     VerticalAlignment="Center" HorizontalContentAlignment="Left"
                                     MinWidth="60" MaxWidth="90"/>
                            <TextBlock Text="{Binding Unit}" Foreground="{DynamicResource SecondaryTextBrush}" 
                                       FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"
                                       Visibility="{Binding Unit, Converter={x:Static views:NullToCollapsedConverter.Instance}}"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </selectors:ParameterTemplateSelector.TplNumericBox>

            <!-- Slider (右侧带可输入 TextBox) 模板 -->
            <selectors:ParameterTemplateSelector.TplSlider>
                <DataTemplate>
                    <Grid Margin="4,3" ToolTip="{Binding Description}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" 
                                   Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                        <DockPanel Grid.Column="1">
                            <!-- 右侧的文字输入框 (与滑块双向绑定) -->
                            <TextBox DockPanel.Dock="Right" Width="44" 
                                     Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F1}}" 
                                     HorizontalContentAlignment="Left" VerticalAlignment="Center"
                                     Margin="6,0,0,0"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Unit}" 
                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10"
                                       VerticalAlignment="Center" Margin="2,0,0,0"
                                       Visibility="{Binding Unit, Converter={x:Static views:NullToCollapsedConverter.Instance}}"/>
                            <!-- 占据中间空间的滑块 -->
                            <Slider Minimum="{Binding MinValue}" Maximum="{Binding MaxValue}" 
                                    Value="{Binding Value}" VerticalAlignment="Center"
                                    TickFrequency="1" IsSnapToTickEnabled="False"/>
                        </DockPanel>
                    </Grid>
                </DataTemplate>
            </selectors:ParameterTemplateSelector.TplSlider>

            <!-- ComboBox 下拉列表模板 -->
            <selectors:ParameterTemplateSelector.TplComboBox>
                <DataTemplate>
                    <Grid Margin="4,3" ToolTip="{Binding Description}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" 
                                   Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" 
                                  SelectedItem="{Binding Value}" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </selectors:ParameterTemplateSelector.TplComboBox>

            <!-- 默认/纯文本 TextBox 模板 -->
            <selectors:ParameterTemplateSelector.TplTextBox>
                <DataTemplate>
                    <Grid Margin="4,3" ToolTip="{Binding Description}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" 
                                   Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                        <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" 
                                 VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </selectors:ParameterTemplateSelector.TplTextBox>

        </selectors:ParameterTemplateSelector>
    </UserControl.Resources>

    <Border Background="{DynamicResource ToolbarBackgroundBrush}">
        <DockPanel>
            <!-- 算法选择器 -->
            <StackPanel DockPanel.Dock="Top" Margin="8,8,8,4">
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="切片配置: " VerticalAlignment="Center" 
                               Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="4,0,8,0"/>
                    <ComboBox Grid.Column="1" 
                              ItemsSource="{Binding SlicingAlgorithms}" 
                              SelectedItem="{Binding SelectedAlgorithm, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </StackPanel>

            <!-- 层级化参数 TabControl（按 Category 自动分组） -->
            <TabControl Background="Transparent" BorderThickness="0" Margin="4,2,4,4"
                        ItemsSource="{Binding Source={StaticResource GroupedParams}, Path=Groups}">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Padding" Value="8,3"/>
                        <Setter Property="BorderThickness" Value="0,0,0,2"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TabControl.Resources>
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" FontWeight="Medium"/>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8" Background="Transparent">
                            <ItemsControl ItemsSource="{Binding Items}" 
                                          ItemTemplateSelector="{StaticResource ParamSelector}"/>
                        </ScrollViewer>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </DockPanel>
    </Border>
</UserControl>
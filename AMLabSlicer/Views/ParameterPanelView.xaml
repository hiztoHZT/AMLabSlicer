<UserControl x:Class="AMLabSlicer.Views.ParameterPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:AMLabSlicer.Views"
             xmlns:selectors="clr-namespace:AMLabSlicer.Selectors"
             MinWidth="280"
             mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="CategoryScrollButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CategoryTabButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="54"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SubcategoryToggleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <selectors:ParameterTemplateSelector x:Key="ParamSelector">
            <selectors:ParameterTemplateSelector.TplCheckBox>
                <DataTemplate>
                    <Grid Margin="8,4" ToolTip="{Binding Description}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13"
                                   TextTrimming="CharacterEllipsis"/>
                        <CheckBox Grid.Column="1" IsChecked="{Binding Value}" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </selectors:ParameterTemplateSelector.TplCheckBox>

            <selectors:ParameterTemplateSelector.TplNumericBox>
                <DataTemplate>
                    <Grid Margin="8,4" ToolTip="{Binding Description}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13"
                                   TextTrimming="CharacterEllipsis"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalAlignment="Center" HorizontalContentAlignment="Left"
                                     MinWidth="74" MaxWidth="96"/>
                            <TextBlock Text="{Binding Unit}" Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"
                                       Visibility="{Binding Unit, Converter={x:Static views:NullToCollapsedConverter.Instance}}"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </selectors:ParameterTemplateSelector.TplNumericBox>

            <selectors:ParameterTemplateSelector.TplSlider>
                <DataTemplate>
                    <Grid Margin="8,4" ToolTip="{Binding Description}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13"
                                   TextTrimming="CharacterEllipsis"/>
                        <DockPanel Grid.Column="1">
                            <TextBox DockPanel.Dock="Right" Width="48"
                                     Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F1}}"
                                     HorizontalContentAlignment="Left" VerticalAlignment="Center"
                                     Margin="6,0,0,0"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Unit}"
                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10"
                                       VerticalAlignment="Center" Margin="2,0,0,0"
                                       Visibility="{Binding Unit, Converter={x:Static views:NullToCollapsedConverter.Instance}}"/>
                            <Slider Minimum="{Binding MinValue}" Maximum="{Binding MaxValue}"
                                    Value="{Binding Value}" VerticalAlignment="Center"
                                    TickFrequency="1" IsSnapToTickEnabled="False"/>
                        </DockPanel>
                    </Grid>
                </DataTemplate>
            </selectors:ParameterTemplateSelector.TplSlider>

            <selectors:ParameterTemplateSelector.TplComboBox>
                <DataTemplate>
                    <Grid Margin="8,4" ToolTip="{Binding Description}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13"
                                   TextTrimming="CharacterEllipsis"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Options}"
                                  SelectedItem="{Binding Value}" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </selectors:ParameterTemplateSelector.TplComboBox>

            <selectors:ParameterTemplateSelector.TplTextBox>
                <DataTemplate>
                    <Grid Margin="8,4" ToolTip="{Binding Description}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </selectors:ParameterTemplateSelector.TplTextBox>
        </selectors:ParameterTemplateSelector>
    </UserControl.Resources>

    <Border Background="{DynamicResource ToolbarBackgroundBrush}">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Height="36" Background="{DynamicResource ToolbarBackgroundBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="&lt;" Style="{StaticResource CategoryScrollButtonStyle}"
                        Click="ScrollCategoriesLeft_Click"/>
                <ScrollViewer x:Name="CategoryScrollViewer"
                              Grid.Column="1"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              CanContentScroll="False"
                              PreviewMouseWheel="CategoryScrollViewer_PreviewMouseWheel">
                    <ItemsControl ItemsSource="{Binding ParameterCategories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}"
                                        Style="{StaticResource CategoryTabButtonStyle}"
                                        Command="{Binding DataContext.SelectParameterCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Button Grid.Column="2" Content="&gt;" Style="{StaticResource CategoryScrollButtonStyle}"
                        Click="ScrollCategoriesRight_Click"/>
            </Grid>

            <Grid DockPanel.Dock="Top" Margin="8,8,8,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="切片配置:" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="4,0,8,0"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding SlicingAlgorithms}"
                          DisplayMemberPath="DisplayName"
                          SelectedItem="{Binding SelectedAlgorithm, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,2,0,8" Background="Transparent">
                <ItemsControl ItemsSource="{Binding SelectedParameterCategory.Subcategories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Border BorderBrush="{DynamicResource ControlBorderBrush}"
                                        BorderThickness="0,1,0,0"
                                        Padding="8,8,8,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="1"
                                                Content="{Binding ToggleText}"
                                                Command="{Binding ToggleCommand}"
                                                Style="{StaticResource SubcategoryToggleButtonStyle}"
                                                ToolTip="展开/收起"/>
                                    </Grid>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Parameters}"
                                              ItemTemplateSelector="{StaticResource ParamSelector}"
                                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>

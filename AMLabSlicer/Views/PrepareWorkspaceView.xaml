<UserControl x:Class="AMLabSlicer.Views.PrepareWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:AMLabSlicer.Plugin.Wpf.Localization;assembly=AMLabSlicer.Plugin.Wpf"
             xmlns:views="clr-namespace:AMLabSlicer.Views"
             xmlns:viewmodel="clr-namespace:AMLabSlicer.ViewModel"
             xmlns:converters="clr-namespace:AMLabSlicer.Converters" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Background="{DynamicResource WindowBackgroundBrush}"
             d:DesignHeight="600" d:DesignWidth="1000">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:HalfWidthConverter x:Key="HalfWidthConv"/>
    </UserControl.Resources>

    <Grid x:Name="MainContainer" Margin="{StaticResource UiWorkspaceMargin}"
          Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <!-- 左侧面板，可折叠 -->
            <ColumnDefinition x:Name="LeftPanelColumn"
                              Width="320"
                              MinWidth="280"
                              MaxWidth="640"/>

            <ColumnDefinition x:Name="PanelSplitterColumn" Width="4"/>
            <ColumnDefinition Width="*" MinWidth="300"/>
            <ColumnDefinition x:Name="AgentSplitterColumn" Width="0"/>
            <ColumnDefinition x:Name="AgentPanelColumn" Width="0" MaxWidth="600"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧整体容器：上=大纲，下=参数 -->
        <Border x:Name="LeftPanelHost"
                Grid.Column="0"
                Background="Transparent"
                CornerRadius="0"
                ClipToBounds="True">
            <Grid Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="OutlinerRow" Height="220" MinHeight="120"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition x:Name="ParameterRow" Height="*" MinHeight="{StaticResource UiParameterPanelMinHeight}"/>
                </Grid.RowDefinitions>

            <!-- 对象大纲 (Outliner) — 固定高度，可用 GridSplitter 调整 -->
            <Border x:Name="OutlinerHost" Grid.Row="0" Style="{StaticResource WorkspacePanelBorderStyle}" ClipToBounds="True">
                <views:OutlinerPanelView/>
            </Border>

            <!-- 拖动分隔条 -->
            <GridSplitter x:Name="OutlinerSplitter" Grid.Row="1"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext"
                          Style="{StaticResource WorkspaceHorizontalSplitterStyle}"/>

            <!-- 参数面板 -->
            <Border x:Name="ParameterHost" Grid.Row="2" Style="{StaticResource WorkspacePanelBorderStyle}" ClipToBounds="True">
                <views:ParameterPanelView/>
            </Border>
            </Grid>
        </Border>

        <GridSplitter x:Name="MainSplitter"
                      Grid.Column="1"
                      Style="{StaticResource WorkspaceVerticalSplitterStyle}"/>

        <Border x:Name="ViewportHost"
                Grid.Column="2"
                Style="{StaticResource WorkspaceViewportBorderStyle}"
                CornerRadius="{StaticResource UiCornerRadius}"
                ClipToBounds="True">
            <views:ModelPreviewView x:Name="ModelPreview"/>
        </Border>

        <GridSplitter x:Name="AgentSplitter" Grid.Column="3" Visibility="Collapsed"
                      Style="{StaticResource WorkspaceVerticalSplitterStyle}" DragCompleted="AgentSplitter_DragCompleted"/>
        <Border x:Name="AgentPanelHost" Grid.Column="4" Visibility="Collapsed"
                Background="Transparent" CornerRadius="0" ClipToBounds="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="32"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="AgentContentHost" Style="{StaticResource WorkspacePanelBorderStyle}"
                        ClipToBounds="True">
                    <ContentControl Content="{Binding SelectedExtensionPanel.Content}"/>
                </Border>
                <Border x:Name="ExtensionRailHost" Grid.Column="2" Style="{StaticResource WorkspacePanelBorderStyle}">
                    <StackPanel Margin="2,4">
                        <ItemsControl ItemsSource="{Binding ExtensionPanels}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Button Content="{Binding Icon}" ToolTip="{Binding Title}" Style="{StaticResource ExtensionRailButtonStyle}"
                                        Command="{Binding DataContext.SelectExtensionPanelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    <Button.Tag><Binding Path="IsSelected"/></Button.Tag>
                                </Button>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="＋" ToolTip="{loc:Text Key='插件管理'}" Style="{StaticResource ExtensionRailButtonStyle}" Command="{Binding OpenExtensionManagementCommand}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 开始切片按钮 -->
        <Button Grid.Column="2" 
                Content="{loc:Text Key='开始切片'}"
                HorizontalAlignment="Right" 
                VerticalAlignment="Bottom" 
                Margin="0,0,22,22"
                Style="{StaticResource PrimaryActionButtonStyle}"
                Command="{Binding StartSlicingCommand}" />
    </Grid>
</UserControl>

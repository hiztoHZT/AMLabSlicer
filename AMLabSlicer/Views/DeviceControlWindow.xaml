<views:ThemedWindow xmlns:views="clr-namespace:AMLabSlicer.Views" x:Class="AMLabSlicer.Views.DeviceControlWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="设备 · Moonraker" Width="760" Height="520" MinWidth="640" MinHeight="440"
 WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
 FontFamily="{DynamicResource UiFontFamily}" FontSize="{DynamicResource UiFontSize}">
 <Window.Resources>
  <Style TargetType="Button" BasedOn="{StaticResource SecondaryActionButtonStyle}"/>
  <Style TargetType="PasswordBox">
   <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
   <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
   <Setter Property="Height" Value="{DynamicResource UiInputHeight}"/>
   <Setter Property="Padding" Value="6,1"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox">
    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid IsEnabled="{Binding CanConnect}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="设备地址" VerticalAlignment="Center" Margin="0,0,12,0"/>
   <TextBox Grid.Column="1" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" ToolTip="Moonraker HTTP 地址；修改后需重新连接"/>
   <Button Grid.Column="2" Content="连接" Command="{Binding ConnectCommand}" Margin="8,0,0,0" Padding="16,3"/>
  </Grid>
  <Grid Grid.Row="1" Margin="0,8,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <TextBlock Text="API Key（可选）" VerticalAlignment="Center" Margin="0,0,12,0"/>
   <PasswordBox Grid.Column="1" PasswordChanged="KeyChanged" ToolTip="仅保留在本窗口内存中，不保存到磁盘"/>
  </Grid>
  <Border Grid.Row="2" Background="{DynamicResource SurfaceElevatedBrush}" CornerRadius="5" Padding="12" Margin="0,0,0,12">
   <StackPanel><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
  </Border>
  <Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,8"><TextBlock Text="设备上的 G-code 文件" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button Content="刷新" Command="{Binding RefreshCommand}" Padding="12,3" Margin="8,0,0,0"/>
    <Button Content="上传 G-code…" Command="{Binding UploadCommand}" Padding="12,3" Margin="8,0,0,0"/>
   </StackPanel></DockPanel>
   <ListBox Background="{DynamicResource SurfaceElevatedBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" Grid.Row="1" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}"/>
  </Grid>
  <StackPanel Grid.Row="4" Margin="0,12,0,0">
   <TextBlock Text="上传不会开始打印。连接功能不验证五轴路径；请使用已适配此机器的 G-code。" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
    <Button Content="开始所选文件" Command="{Binding StartCommand}" Padding="12,4"/>
    <Button Content="暂停" Command="{Binding PauseCommand}" Margin="8,0,0,0" Padding="12,4"/>
    <Button Content="恢复" Command="{Binding ResumeCommand}" Margin="8,0,0,0" Padding="12,4"/>
    <Button Content="取消打印" Command="{Binding CancelCommand}" Margin="8,0,0,0" Padding="12,4"/>
   </StackPanel>
  </StackPanel>
 </Grid>
</views:ThemedWindow>

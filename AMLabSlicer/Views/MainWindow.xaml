<Window x:Class="AMLabSlicer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:AMLabSlicer.Plugin.Wpf.Localization;assembly=AMLabSlicer.Plugin.Wpf"
        xmlns:svg="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf"
        xmlns:viewmodel="clr-namespace:AMLabSlicer.ViewModel"
        xmlns:views="clr-namespace:AMLabSlicer.Views"
        FontFamily="{DynamicResource UiFontFamily}" FontSize="{DynamicResource UiFontSize}"
        Title="AMLab Slicer" Height="720" Width="1280" Background="{DynamicResource WindowBackgroundBrush}" TextElement.Foreground="{DynamicResource PrimaryTextBrush}" MinHeight="600" MinWidth="960"
        WindowStyle="None" AllowsTransparency="False" ResizeMode="CanResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True">


    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="{StaticResource UiCornerRadius}"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type viewmodel:PrepareWorkspaceViewModel}">
            <views:PrepareWorkspaceView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="{DynamicResource UiConfigRowGridHeight}"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource TitleBarBackgroundBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="0,0,0,1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <svg:SvgViewbox Source="/Assets/Images/AMLab_logo_rgb.svg" Width="25" Height="25" Margin="12,0,6,0" VerticalAlignment="Center"/>
            <Menu Grid.Column="1" Background="Transparent" FontSize="{DynamicResource UiTitleFontSize}" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">

                <MenuItem Header="{loc:Text Key='文件'}" Style="{StaticResource TopLevelHeaderStyle}">
                    <MenuItem Header="{loc:Text Key='载入模型...'}" Command="{Binding LoadModelCommand}" Style="{StaticResource SubmenuItemStyle}"/>
                </MenuItem>

                <MenuItem Header="{loc:Text Key='设置'}" Style="{StaticResource TopLevelHeaderStyle}">
                    <MenuItem Header="{loc:Text Key='首选项...'}" Command="{Binding OpenPreferencesCommand}" Style="{StaticResource SubmenuItemStyle}"/>
                </MenuItem>
                <MenuItem Header="{loc:Text Key='插件'}" Style="{StaticResource TopLevelHeaderStyle}">
                    <MenuItem Header="{loc:Text Key='Agent 设置...'}" Command="{Binding OpenExtensionsCommand}" Style="{StaticResource SubmenuItemStyle}"/>
                    <MenuItem Header="{loc:Text Key='插件管理...'}" Command="{Binding OpenExtensionManagementCommand}" Style="{StaticResource SubmenuItemStyle}"/>
                </MenuItem>

                <MenuItem Header="{loc:Text Key='编辑'}" Style="{StaticResource TopLevelHeaderStyle}">
                    <MenuItem Header="{loc:Text Key='撤销'}" InputGestureText="Ctrl+Z"
                              Command="{Binding UndoCommand}" Style="{StaticResource SubmenuItemStyle}"/>
                    <MenuItem Header="{loc:Text Key='重做'}" InputGestureText="Ctrl+Shift+Z"
                              Command="{Binding RedoCommand}" Style="{StaticResource SubmenuItemStyle}"/>
                </MenuItem>
            </Menu>

            <StackPanel Grid.Column="3" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Stretch" Margin="0,0,6,0">
                <Button Content="—" Width="45" Style="{StaticResource WindowButtonStyle}" Click="BtnMinimize_Click"/>
                <Button Content="☐" Width="45" Style="{StaticResource WindowButtonStyle}" Click="BtnMaximize_Click"/>
                <Button Content="✕" Width="45" Style="{StaticResource CloseButtonStyle}" Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{DynamicResource ToolbarBackgroundBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource SidebarToggleButtonStyle}"
                        Command="{Binding CurrentWorkspace.TogglePanelCommand}"
                        WindowChrome.IsHitTestVisibleInChrome="True"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Stretch">
                    <Button Content="{loc:Text Key='准备'}" Style="{StaticResource WorkspaceNavButtonStyle}" Tag="active"/>
                    <Button Content="{loc:Text Key='预览'}" Style="{StaticResource WorkspaceNavButtonStyle}"/>
                    <Button Content="{loc:Text Key='设备'}" Style="{StaticResource WorkspaceNavButtonStyle}"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource SidebarToggleButtonStyle}"
                        FocusVisualStyle="{x:Null}"
                        ToolTip="{loc:Text Key='展开/收起插件面板'}" Command="{Binding CurrentWorkspace.ToggleAgentPanelCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="RightToggleBorder" Background="{TemplateBinding Background}" CornerRadius="{StaticResource UiCornerRadius}">
                                <Path Width="16" Height="16" Stretch="Uniform" Data="{StaticResource PanelRightIconGeometry}"
                                      Stroke="{TemplateBinding Foreground}" StrokeThickness="2" StrokeLineJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RightToggleBorder" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>


                <!-- Legacy nav removed:
                <Button Content="准 备" Style="{StaticResource WorkspaceNavButtonStyle}" Tag="active"/>
                <Button Content="预 览" Style="{StaticResource WorkspaceNavButtonStyle}"/>
                <Button Content="设 备" Style="{StaticResource WorkspaceNavButtonStyle}"/>
                -->
            </Grid>
        </Border>

        <ContentControl Grid.Row="2" Content="{Binding CurrentWorkspace}" />
    </Grid>
</Window>

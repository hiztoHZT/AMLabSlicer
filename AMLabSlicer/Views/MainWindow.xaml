<Window x:Class="AMLabSlicer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svg="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf"
        xmlns:viewmodel="clr-namespace:AMLabSlicer.ViewModel"
        xmlns:views="clr-namespace:AMLabSlicer.Views"
        Title="AMLab Slicer" Height="720" Width="1280" Background="{DynamicResource WindowBackgroundBrush}" TextElement.Foreground="{DynamicResource PrimaryTextBrush}" MinHeight="600" MinWidth="800"
        WindowStyle="None" AllowsTransparency="False" ResizeMode="CanResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True">


    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type viewmodel:PrepareWorkspaceViewModel}">
            <views:PrepareWorkspaceView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource TitleBarBackgroundBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="0,0,0,1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <svg:SvgViewbox Source="/Assets/Images/AMLab_logo_rgb.svg" Width="25" Height="25" Margin="12,0,6,0" VerticalAlignment="Center"/>
            <Menu Grid.Column="1" Background="Transparent" FontSize="13" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">

                <MenuItem Header="文件" Style="{StaticResource TopLevelHeaderStyle}">
                    <MenuItem Header="载入模型..." Command="{Binding LoadModelCommand}" Style="{StaticResource SubmenuItemStyle}"/>
                </MenuItem>

                <MenuItem Header="设置" Style="{StaticResource TopLevelHeaderStyle}">
                    <MenuItem Header="首选项..." Command="{Binding OpenPreferencesCommand}" Style="{StaticResource SubmenuItemStyle}"/>
                </MenuItem>

                <MenuItem Header="编辑" Style="{StaticResource TopLevelHeaderStyle}">
                    <MenuItem Header="撤销" InputGestureText="Ctrl+Z"
                              Command="{Binding UndoCommand}" Style="{StaticResource SubmenuItemStyle}"/>
                    <MenuItem Header="重做" InputGestureText="Ctrl+Shift+Z"
                              Command="{Binding RedoCommand}" Style="{StaticResource SubmenuItemStyle}"/>
                </MenuItem>
            </Menu>

            <StackPanel Grid.Column="3" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Stretch" Margin="0,0,6,0">
                <Button Content="—" Width="45" Style="{StaticResource WindowButtonStyle}" Click="BtnMinimize_Click"/>
                <Button Content="☐" Width="45" Style="{StaticResource WindowButtonStyle}" Click="BtnMaximize_Click"/>
                <Button Content="✕" Width="45" Style="{StaticResource CloseButtonStyle}" Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{DynamicResource ToolbarBackgroundBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource SidebarToggleButtonStyle}"
                        Command="{Binding CurrentWorkspace.TogglePanelCommand}"
                        WindowChrome.IsHitTestVisibleInChrome="True"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Stretch">
                    <Button Content="准备" Style="{StaticResource WorkspaceNavButtonStyle}" Tag="active"/>
                    <Button Content="预览" Style="{StaticResource WorkspaceNavButtonStyle}"/>
                    <Button Content="设备" Style="{StaticResource WorkspaceNavButtonStyle}"/>
                </StackPanel>

                <!-- Legacy nav removed:
                <Button Content="准 备" Style="{StaticResource WorkspaceNavButtonStyle}" Tag="active"/>
                <Button Content="预 览" Style="{StaticResource WorkspaceNavButtonStyle}"/>
                <Button Content="设 备" Style="{StaticResource WorkspaceNavButtonStyle}"/>
                -->
            </Grid>
        </Border>

        <ContentControl Grid.Row="2" Content="{Binding CurrentWorkspace}" />
    </Grid>
</Window>

<UserControl x:Class="AMLabSlicer.Views.ModelPreviewView"
             x:Name="Me"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             MinWidth="300" MinHeight="400"
             mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>

        <!-- 工具栏普通按钮样式（默认灰暗，激活时蓝色） -->
        <Style x:Key="TBBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="IsEnabled" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="active">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 始终启用的工具按钮 -->
        <Style x:Key="TBBtnOn" TargetType="Button" BasedOn="{StaticResource TBBtn}">
            <Setter Property="IsEnabled" Value="True"/>
        </Style>
        <!-- 面模式工具按钮 -->
        <Style x:Key="FBBtn" TargetType="Button" BasedOn="{StaticResource TBBtnOn}"/>
        <!-- 工具栏分隔线 -->
        <Style x:Key="Sep" TargetType="Separator">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Background" Value="#44FFFFFF"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>

        <!-- 输入框样式 -->
        <Style x:Key="TxfStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="#44FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ViewportBackgroundBrush}">

        <!-- 3D 视口 -->
        <hx:Viewport3DX x:Name="MainViewport"
                        BackgroundColor="#393939"
                        ShowCoordinateSystem="{Binding AppPrefs.ShowCoordinateSystem}"
                        CoordinateSystemLabelForeground="{DynamicResource PrimaryTextColor}"
                        UseDefaultGestures="False"
                        IsInertiaEnabled="False"
                        IsPanEnabled="False"
                        IsRotationEnabled="False"
                        IsZoomEnabled="False"
                        IsMoveEnabled="False"
                        FXAALevel="{Binding AppPrefs.FXAALevel}"
                        PreviewMouseDown="MainViewport_PreviewMouseDown"
                        PreviewMouseUp="MainViewport_PreviewMouseUp"
                        PreviewMouseMove="MainViewport_PreviewMouseMove"
                        PreviewMouseWheel="MainViewport_PreviewMouseWheel">

            <hx:AmbientLight3D Color="#404040"/>
            <hx:DirectionalLight3D Direction="{Binding Camera.LookDirection, ElementName=MainViewport}" Color="#CCCCCC"/>

            <hx:LineGeometryModel3D Geometry="{Binding MinorGridGeometry}" Color="#2A2A2A" Thickness="0.5"/>
            <hx:LineGeometryModel3D Geometry="{Binding MajorGridGeometry}" Color="#555555" Thickness="1"/>
            <hx:Element3DPresenter Content="{Binding LoadedModel}"/>
            <hx:LineGeometryModel3D Geometry="{Binding ObjectHighlightGeometry, ElementName=Me}"
                                    Color="#2D9BFF"
                                    Thickness="1.6"
                                    Visibility="{Binding IsObjectHighlightVisible, ElementName=Me, Converter={StaticResource B2V}}"/>
            <hx:LineGeometryModel3D Geometry="{Binding FaceWireframeGeometry, ElementName=Me}"
                                    Color="#111111"
                                    Thickness="0.6"
                                    Visibility="{Binding IsFaceOverlayVisible, ElementName=Me, Converter={StaticResource B2V}}"/>
            <hx:LineGeometryModel3D Geometry="{Binding FaceCenterDotGeometry, ElementName=Me}"
                                    Color="#111111"
                                    Thickness="0.8"
                                    Visibility="{Binding IsFaceCenterDotVisible, ElementName=Me, Converter={StaticResource B2V}}"/>
            <hx:MeshGeometryModel3D Geometry="{Binding FaceSelectionGeometry, ElementName=Me}"
                                    CullMode="None"
                                    IsTransparent="True"
                                    Visibility="{Binding IsFaceSelectionVisible, ElementName=Me, Converter={StaticResource B2V}}">
                <hx:MeshGeometryModel3D.Material>
                    <hx:PhongMaterial DiffuseColor="#B22D9BFF" AmbientColor="#7A2D9BFF" SpecularColor="#00000000"/>
                </hx:MeshGeometryModel3D.Material>
            </hx:MeshGeometryModel3D>
            <hx:LineGeometryModel3D Geometry="{Binding FaceSelectionEdgeGeometry, ElementName=Me}"
                                    Color="#2D9BFF"
                                    Thickness="1.6"
                                    Visibility="{Binding IsFaceSelectionVisible, ElementName=Me, Converter={StaticResource B2V}}"/>

            <!-- Manipulator：绑定到 SelectedNode，尺寸适当放大 -->
            <hx:TransformManipulator3D x:Name="ObjectManipulator"
                                       Target="{Binding SelectedNode, ElementName=Me}"
                                       EnableScaling="True"
                                       EnableRotation="True"
                                       EnableTranslation="True"
                                       SizeScale="2.5"
                                       Visibility="{Binding IsManipulatorVisible, ElementName=Me, Converter={StaticResource B2V}}"/>
        </hx:Viewport3DX>

        <!-- 顶部工具栏区域 -->
        <Grid VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="0,8,0,0"
              IsHitTestVisible="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── 物体模式工具栏 ── -->
            <Border Grid.Row="0" x:Name="ObjectToolbar"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource ToolbarBackgroundBrush}"
                    CornerRadius="8" Padding="6,4"
                    Visibility="{Binding IsObjectMode, Converter={StaticResource B2V}}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Button x:Name="BtnMove"   Content="G  移动"   Style="{StaticResource TBBtn}" Click="ToolBtn_Click" Tag="G"/>
                    <Button x:Name="BtnRotate" Content="R  旋转"   Style="{StaticResource TBBtn}" Click="ToolBtn_Click" Tag="R"/>
                    <Button x:Name="BtnScale"  Content="S  缩放"   Style="{StaticResource TBBtn}" Click="ToolBtn_Click" Tag="S"/>
                    <Separator Style="{StaticResource Sep}"/>
                    <Button x:Name="BtnFace"   Content="F  底面"   Style="{StaticResource TBBtn}" Click="ToolBtn_Click" Tag="F"/>
                    <Separator Style="{StaticResource Sep}"/>
                    <Button x:Name="BtnArrange" Content="A  摆放"  Style="{StaticResource TBBtnOn}" Click="ToolBtn_Click" Tag="A"/>
                    <Separator Style="{StaticResource Sep}"/>
                    <Button x:Name="BtnSplit"  Content="B  拆分"   Style="{StaticResource TBBtn}" Click="ToolBtn_Click" Tag="B"/>
                    <Button x:Name="BtnDelete" Content="X  删除"   Style="{StaticResource TBBtn}" Click="ToolBtn_Click" Tag="X"/>
                    <Separator Style="{StaticResource Sep}"/>
                    <Button x:Name="BtnMode" Content="Tab ▶ 面模式" Style="{StaticResource TBBtn}" Click="ToolBtn_Click" Tag="Tab"/>
                </StackPanel>
            </Border>

            <!-- ── 面模式工具栏 ── -->
            <Border Grid.Row="0"
                    HorizontalAlignment="Center"
                    Background="#CC1A3A5C"
                    CornerRadius="8" Padding="6,4"
                    Visibility="{Binding IsFaceMode, Converter={StaticResource B2V}}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2266CC" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                        <TextBlock Text="● 面  模  式" Foreground="White" FontWeight="Bold" FontSize="11"/>
                    </Border>
                    <Button x:Name="FBtnClick"  Content="Q 点选"  Style="{StaticResource FBBtn}" Click="FaceTool_Click" Tag="Q"/>
                    <Button x:Name="FBtnBox"    Content="W 框选"  Style="{StaticResource FBBtn}" Click="FaceTool_Click" Tag="W"/>
                    <Button x:Name="FBtnBrush"  Content="E 刷选"  Style="{StaticResource FBBtn}" Click="FaceTool_Click" Tag="E"/>
                    <Button x:Name="FBtnLasso"  Content="R 套索"  Style="{StaticResource FBBtn}" Click="FaceTool_Click" Tag="R"/>
                    <Button x:Name="FBtnAll"    Content="A 全选"  Style="{StaticResource FBBtn}" Click="FaceTool_Click" Tag="A"/>
                    <Separator Style="{StaticResource Sep}"/>
                    <Button x:Name="FBtnXRay"   Content="T 透视"  Style="{StaticResource FBBtn}" Click="FaceTool_Click" Tag="T"/>
                    <Button x:Name="FBtnLinked" Content="L 连通"  Style="{StaticResource FBBtn}" Click="FaceTool_Click" Tag="L"/>
                    <Separator Style="{StaticResource Sep}"/>
                    <Border x:Name="BrushPanel" Background="#22000000" CornerRadius="4" Padding="6,2" Margin="2,0"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="半径" Foreground="White" FontSize="11" Margin="0,0,4,0"/>
                            <Slider x:Name="BrushSizeSlider" Width="90" Minimum="4" Maximum="60" Value="14"
                                    SmallChange="1" LargeChange="4" ValueChanged="BrushSizeSlider_ValueChanged"/>
                            <TextBlock x:Name="BrushSizeText" Text="14" Foreground="White" FontSize="11" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="LinkedPanel" Background="#22000000" CornerRadius="4" Padding="6,2" Margin="2,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="模式" Foreground="White" FontSize="11" Margin="0,0,4,0"/>
                            <ComboBox x:Name="LinkedModeCombo" Width="86" Height="22" SelectionChanged="LinkedModeCombo_SelectionChanged">
                                <ComboBoxItem Content="连通面" IsSelected="True"/>
                                <ComboBoxItem Content="连通对象"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>
                    <Separator Style="{StaticResource Sep}"/>
                    <Button Content="S 保存" Style="{StaticResource FBBtn}" Click="FaceTool_Click" Tag="S"/>
                    <Button Content="D 另存" Style="{StaticResource FBBtn}" Click="FaceTool_Click" Tag="D"/>
                    <Separator Style="{StaticResource Sep}"/>
                    <Button Content="Tab ◀ 退出" Style="{StaticResource FBBtn}" Click="FaceTool_Click" Tag="Tab"/>
                </StackPanel>
            </Border>

            <!-- ── 变换精确输入栏（G/R/S激活后显示）── -->
            <Border x:Name="TransformInputBar" Grid.Row="1"
                    HorizontalAlignment="Center" Margin="0,6,0,0"
                    Background="{DynamicResource ToolbarBackgroundBrush}"
                    CornerRadius="6" Padding="12,6"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 模式标签 -->
                    <TextBlock x:Name="TransformLabel" Text="移动"
                               Foreground="{DynamicResource AccentBrush}"
                               FontWeight="Bold" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <!-- X -->
                    <TextBlock Text="X" FontWeight="Bold" Foreground="#FF6680"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="TxfX" Width="64" Style="{StaticResource TxfStyle}"
                             TextChanged="TransformBox_Changed" KeyDown="TransformBox_KeyDown"/>
                    <!-- Y -->
                    <TextBlock Text="Y" FontWeight="Bold" Foreground="#66FF88"
                               VerticalAlignment="Center" Margin="10,0,4,0"/>
                    <TextBox x:Name="TxfY" Width="64" Style="{StaticResource TxfStyle}"
                             TextChanged="TransformBox_Changed" KeyDown="TransformBox_KeyDown"/>
                    <!-- Z（仅旋转和缩放显示）-->
                    <TextBlock x:Name="LblZ" Text="Z" FontWeight="Bold" Foreground="#6699FF"
                               VerticalAlignment="Center" Margin="10,0,4,0"/>
                    <TextBox x:Name="TxfZ" Width="64" Style="{StaticResource TxfStyle}"
                             TextChanged="TransformBox_Changed" KeyDown="TransformBox_KeyDown"/>
                    <!-- 按钮 -->
                    <Button Content="✓ 确认" Margin="12,0,0,0" Padding="10,4" Click="ApplyTransform_Click"
                            Background="{DynamicResource AccentBrush}" Foreground="White"
                            BorderThickness="0" IsEnabled="True"/>
                    <Button Content="↺ 重置" Margin="4,0,0,0" Padding="8,4" Click="ResetTransform_Click"
                            Background="#33FFFFFF" Foreground="{DynamicResource PrimaryTextBrush}"
                            BorderThickness="0" IsEnabled="True"/>
                    <Button Content="✕" Margin="4,0,0,0" Padding="6,4" Click="CloseInputBar_Click"
                            Background="Transparent" Foreground="{DynamicResource SecondaryTextBrush}"
                            BorderThickness="0" IsEnabled="True"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="18,116,0,0"
                Padding="8,6"
                CornerRadius="4"
                Background="#33000000"
                IsHitTestVisible="False">
            <StackPanel>
                <TextBlock Text="{Binding ModeInfoText, ElementName=Me}"
                           Foreground="#C8D8E8"
                           FontSize="11"/>
                <TextBlock Text="{Binding SelectionInfoText, ElementName=Me}"
                           Foreground="#A7BDD2"
                           FontSize="11"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <Canvas x:Name="FaceOverlayCanvas"
                Background="Transparent"
                IsHitTestVisible="False">
            <Rectangle x:Name="FaceRectSelection"
                       Visibility="Collapsed"
                       Stroke="#DD55AAFF"
                       StrokeThickness="1.2"
                       Fill="#2255AAFF"/>
            <Polyline x:Name="FaceLassoPath"
                      Visibility="Collapsed"
                      Stroke="#DD55AAFF"
                      StrokeThickness="1.2"/>
            <Ellipse x:Name="BrushPreviewCircle"
                     Visibility="Collapsed"
                     Stroke="#EE66BBFF"
                     StrokeThickness="1.2"
                     Fill="#223388FF"/>
        </Canvas>

        <!-- 左侧面板折叠按钮 -->
        <Button Command="{Binding TogglePanelCommand}"
                Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="2" Background="{DynamicResource MenuItemBackgroundBrush}"
                BorderThickness="0" Cursor="Hand" FontSize="11">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Content" Value="❮"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsParameterPanelOpen}" Value="False">
                            <Setter Property="Content" Value="❯"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

    </Grid>
</UserControl>

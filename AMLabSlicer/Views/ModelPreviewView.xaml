<UserControl x:Class="AMLabSlicer.Views.ModelPreviewView"
             x:Name="Me"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:AMLabSlicer.Plugin.Wpf.Localization;assembly=AMLabSlicer.Plugin.Wpf"
             xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             MinWidth="300" MinHeight="400"
             mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>

        <!-- 工具栏普通按钮样式（默认灰暗，激活时蓝色） -->
        <Style x:Key="TBBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="{DynamicResource UiActionHeight}"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="FontSize" Value="{DynamicResource UiFontSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="IsEnabled" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource UiCornerRadius}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="active">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MutedAccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 始终启用的工具按钮 -->
        <Style x:Key="TBBtnOn" TargetType="Button" BasedOn="{StaticResource TBBtn}">
            <Setter Property="IsEnabled" Value="True"/>
        </Style>
        <!-- 工具栏分隔线 -->
        <Style x:Key="Sep" TargetType="Separator">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBorderBrush}"/>
            <Setter Property="Margin" Value="5,0"/>
        </Style>

        <!-- 输入框样式 -->
        <Style x:Key="TxfStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="{DynamicResource UiInputHeight}"/>
            <Setter Property="Padding" Value="{StaticResource UiInputPadding}"/>
            <Setter Property="FontSize" Value="{DynamicResource UiFontSize}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource UiCornerRadius}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ControlFocusBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FloatingToolbarBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource OverlayPanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource UiCornerRadius}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="TransformActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Background" Value="{DynamicResource MutedAccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="{DynamicResource UiFontSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{StaticResource UiCornerRadius}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TransformSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource TransformActionButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>

        <Style x:Key="TransformCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TransformSecondaryButtonStyle}">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ViewportBackgroundBrush}">

        <!-- 3D 视口 -->
        <hx:Viewport3DX x:Name="MainViewport"
                        ShowCoordinateSystem="False"
                        ShowViewCube="False"
                        CoordinateSystemLabelForeground="{DynamicResource PrimaryTextColor}"
                        UseDefaultGestures="False"
                        IsInertiaEnabled="False"
                        IsPanEnabled="False"
                        IsRotationEnabled="False"
                        IsZoomEnabled="False"
                        IsMoveEnabled="False"
                        EnableSSAO="{Binding AppPrefs.EnableSSAO}"
                        FXAALevel="{Binding AppPrefs.FXAALevel}"
                        PreviewMouseDown="MainViewport_PreviewMouseDown"
                        PreviewMouseUp="MainViewport_PreviewMouseUp"
                        PreviewMouseMove="MainViewport_PreviewMouseMove"
                        PreviewMouseWheel="MainViewport_PreviewMouseWheel">

            <hx:Viewport3DX.Style>
                <Style TargetType="hx:Viewport3DX">
                    <Setter Property="BackgroundColor" Value="#333333"/>
                    <Style.Triggers><DataTrigger Binding="{Binding AppPrefs.Theme}" Value="浅色"><Setter Property="BackgroundColor" Value="#E4E7EC"/></DataTrigger></Style.Triggers>
                </Style>
            </hx:Viewport3DX.Style>
            <hx:AmbientLight3D Color="#4D4D4D"/>
            <hx:DirectionalLight3D Direction="{Binding Camera.LookDirection, ElementName=MainViewport}" Color="#CCCCCC"/>

            <hx:LineGeometryModel3D Geometry="{Binding MinorGridGeometry}" Visibility="{Binding AppPrefs.ShowBuildGrid, Converter={StaticResource B2V}}" Color="{DynamicResource BuildGridMinorColor}" Thickness="0.5"/>
            <hx:LineGeometryModel3D Geometry="{Binding MajorGridGeometry}" Visibility="{Binding AppPrefs.ShowBuildGrid, Converter={StaticResource B2V}}" Color="{DynamicResource BuildGridMajorColor}" Thickness="1"/>
            <hx:Element3DPresenter Content="{Binding LoadedModel}"/>
            <hx:LineGeometryModel3D Geometry="{Binding ObjectHighlightGeometry, ElementName=Me}"
                                    Transform="{Binding ObjectHighlightTransform, ElementName=Me}"
                                    Color="#2D9BFF"
                                    Thickness="1.6"
                                    Visibility="{Binding IsObjectHighlightVisible, ElementName=Me, Converter={StaticResource B2V}}"/>
            <!-- GizmoAnchor 留作未来拓展或作为 3D 定位锚点，隐藏不显示 -->
            <hx:GroupModel3D x:Name="GizmoAnchor" Visibility="Collapsed"/>

            <!-- Manipulator 完全隐藏，使用 Blender 快捷键模式替代其视觉交互 -->
            <hx:TransformManipulator3D x:Name="ObjectManipulator"
                                       Target="{Binding ElementName=GizmoAnchor}"
                                       EnableScaling="False" EnableRotation="False" EnableTranslation="False"
                                       Visibility="Collapsed"/>
                                       
            <!-- 添加约束辅助线 3D 渲染支持 -->
            <hx:LineGeometryModel3D Geometry="{Binding ModalConstraintGeometry, ElementName=Me}"
                                    Color="{Binding ModalConstraintColor, ElementName=Me, FallbackValue=Transparent}"
                                    Thickness="2.0"
                                    IsHitTestVisible="False"/>
        </hx:Viewport3DX>

        <!-- 顶部工具栏区域 -->
        <Grid VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="0,8,0,0"
              IsHitTestVisible="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── 物体模式工具栏 ── -->
            <Border Grid.Row="0" x:Name="ObjectToolbar"
                    HorizontalAlignment="Center"
                    Style="{StaticResource FloatingToolbarBorderStyle}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Button x:Name="BtnMove"   Content="{loc:Text Key='G 移动'}"   Style="{StaticResource TBBtn}" Click="ToolBtn_Click" Tag="G"/>
                    <Button x:Name="BtnRotate" Content="{loc:Text Key='R 旋转'}"   Style="{StaticResource TBBtn}" Click="ToolBtn_Click" Tag="R"/>
                    <Button x:Name="BtnScale"  Content="{loc:Text Key='S 缩放'}"   Style="{StaticResource TBBtn}" Click="ToolBtn_Click" Tag="S"/>
                    <Separator Style="{StaticResource Sep}"/>
                    <Button x:Name="BtnFace"   Content="{loc:Text Key='F 底面'}"   Style="{StaticResource TBBtn}" Click="ToolBtn_Click" Tag="F"/>
                    <Separator Style="{StaticResource Sep}"/>
                    <Button x:Name="BtnArrange" Content="{loc:Text Key='A 摆放'}"  Style="{StaticResource TBBtnOn}" Click="ToolBtn_Click" Tag="A"/>
                    <Separator Style="{StaticResource Sep}"/>
                    <Button x:Name="BtnSplit"  Content="{loc:Text Key='B 拆分'}"   Style="{StaticResource TBBtn}" Click="ToolBtn_Click" Tag="B"/>
                    <Button x:Name="BtnDelete" Content="{loc:Text Key='X 删除'}"   Style="{StaticResource TBBtn}" Click="ToolBtn_Click" Tag="X"/>
                </StackPanel>
            </Border>

            <!-- ── 变换精确输入栏（G/R/S激活后显示）── -->
            <Border x:Name="TransformInputBar" Grid.Row="1"
                    HorizontalAlignment="Center" Margin="0,6,0,0"
                    Style="{StaticResource FloatingToolbarBorderStyle}"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 模式标签 -->
                    <TextBlock x:Name="TransformLabel" Text="{loc:Text Key='移动'}"
                               Foreground="{DynamicResource AccentBrush}"
                               FontWeight="Bold" FontSize="{DynamicResource UiFontSize}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <!-- X -->
                    <TextBlock x:Name="LblX" Text="X" FontWeight="Bold" Foreground="#FF6680"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="TxfX" Width="72" Style="{StaticResource TxfStyle}"
                             TextChanged="TransformBox_Changed" KeyDown="TransformBox_KeyDown"/>
                    <!-- Y -->
                    <TextBlock x:Name="LblY" Text="Y" FontWeight="Bold" Foreground="#66FF88"
                               VerticalAlignment="Center" Margin="10,0,4,0"/>
                    <TextBox x:Name="TxfY" Width="72" Style="{StaticResource TxfStyle}"
                             TextChanged="TransformBox_Changed" KeyDown="TransformBox_KeyDown"/>
                    <!-- Z（仅旋转和缩放显示）-->
                    <TextBlock x:Name="LblZ" Text="Z" FontWeight="Bold" Foreground="#6699FF"
                               VerticalAlignment="Center" Margin="10,0,4,0"/>
                    <TextBox x:Name="TxfZ" Width="72" Style="{StaticResource TxfStyle}"
                             TextChanged="TransformBox_Changed" KeyDown="TransformBox_KeyDown"/>
                    <!-- 按钮 -->
                    <Button Content="{loc:Text Key='✓ 确认'}" Margin="12,0,0,0" Click="ApplyTransform_Click"
                            Style="{StaticResource TransformActionButtonStyle}" IsEnabled="True"/>
                    <Button Content="{loc:Text Key='↺ 重置'}" Margin="4,0,0,0" Click="ResetTransform_Click"
                            Style="{StaticResource TransformSecondaryButtonStyle}" IsEnabled="True"/>
                    <Button Content="✕" Margin="4,0,0,0" Click="CloseInputBar_Click"
                            Style="{StaticResource TransformCloseButtonStyle}" IsEnabled="True"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="18,116,0,0"
                Padding="8,6"
                CornerRadius="{StaticResource UiCornerRadius}"
                Background="{DynamicResource OverlayPanelBrush}"
                Visibility="{Binding AppPrefs.ShowViewportStatus, Converter={StaticResource B2V}}"
                IsHitTestVisible="False">
            <StackPanel>
                <TextBlock Text="{loc:LocalizedBinding ModeInfoText, ElementName=Me}"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           FontSize="{DynamicResource UiTitleFontSize}"/>
                <TextBlock Text="{loc:LocalizedBinding SelectionInfoText, ElementName=Me}"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           FontSize="{DynamicResource UiTitleFontSize}"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- 2D 悬浮 ViewCube 小视口 -->
        <Canvas x:Name="ViewCubeCanvas"
                Width="100" Height="100"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="20, 0, 0, 20"
                Background="#01000000"
                IsHitTestVisible="True"
                MouseLeftButtonDown="ViewCubeCanvas_MouseLeftButtonDown"
                MouseMove="ViewCubeCanvas_MouseMove"
                MouseLeave="ViewCubeCanvas_MouseLeave">
        </Canvas>

        <!-- 左侧面板折叠按钮 -->
        <!-- Legacy viewport panel toggle moved to the main toolbar.
        <Button Visibility="Collapsed"
                Command="{Binding TogglePanelCommand}"
                Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="2" Background="{DynamicResource MenuItemBackgroundBrush}"
                BorderThickness="0" Cursor="Hand" FontSize="{DynamicResource UiSmallFontSize}">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Content" Value="❮"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsParameterPanelOpen}" Value="False">
                            <Setter Property="Content" Value="❯"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        -->

    </Grid>
</UserControl>

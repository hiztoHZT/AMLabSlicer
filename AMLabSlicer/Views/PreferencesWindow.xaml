<views:ThemedWindow x:Class="AMLabSlicer.Views.PreferencesWindow"
        xmlns:views="clr-namespace:AMLabSlicer.Views"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:AMLabSlicer.Plugin.Wpf.Localization;assembly=AMLabSlicer.Plugin.Wpf"
        Title="{loc:Text Key='首选项'}" Width="780" Height="620" MinWidth="640" MinHeight="480" WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource UiFontFamily}" FontSize="{DynamicResource UiFontSize}"
        Foreground="{DynamicResource PrimaryTextBrush}" Background="{DynamicResource WindowBackgroundBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="SettingsLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style x:Key="SettingsHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,8"/>
        </Style>
        <Style x:Key="SettingsHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource UiTitleFontSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ListBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}" Style="{StaticResource SectionNavigationStyle}"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{loc:LocalizedBinding .}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate></ListBox>
            <ScrollViewer x:Name="SettingsScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,8,0">
                    <StackPanel Visibility="{Binding IsAppearanceSection, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource SettingsCardStyle}"><StackPanel>
                        <TextBlock Text="{loc:Text Key='主题与字体'}" Style="{StaticResource SettingsHeading}"/>
                    <Grid Margin="0,4" MinHeight="{DynamicResource UiParameterRowHeight}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Text Key='界面语言'}" Style="{StaticResource SettingsLabel}"/>
                        <ComboBox x:Name="LanguageSelector" Grid.Column="1" ItemsSource="{Binding Languages}" SelectedValue="{Binding Language}" SelectedValuePath="Id" Height="{DynamicResource UiInputHeight}" VerticalAlignment="Center">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <Grid Margin="0,4" MinHeight="{DynamicResource UiParameterRowHeight}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Text Key='界面主题'}" Style="{StaticResource SettingsLabel}"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" Height="{DynamicResource UiInputHeight}" VerticalAlignment="Center"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{loc:LocalizedBinding .}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                    </Grid>
                    <Grid Margin="0,4" MinHeight="{DynamicResource UiParameterRowHeight}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Text Key='界面字体'}" Style="{StaticResource SettingsLabel}"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding FontFamilies}" SelectedItem="{Binding FontFamilyName}" Height="{DynamicResource UiInputHeight}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,4" MinHeight="{DynamicResource UiParameterRowHeight}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Text Key='字体大小'}" Style="{StaticResource SettingsLabel}"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding FontSizes}" SelectedItem="{Binding FontSize}" Height="{DynamicResource UiInputHeight}" VerticalAlignment="Center"/>
                    </Grid>
                        <TextBlock Text="{loc:Text Key='字体、主题即时生效；较大字号会同步增加控件高度。'}" Style="{StaticResource SettingsHint}"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource SettingsCardStyle}"><StackPanel>
                        <TextBlock Text="{loc:Text Key='字体预览'}" Style="{StaticResource SettingsHeading}"/>
                        <TextBlock Text="{loc:Text Key='AMLabSlicer · 层高 0.20 mm'}" Margin="0,4"/>
                        <TextBlock Text="{loc:Text Key='参数设置 / Agent 对话 / 0123456789'}" Style="{StaticResource SettingsHint}"/>
                    </StackPanel></Border>
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsViewportSection, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource SettingsCardStyle}"><StackPanel>
                        <TextBlock Text="{loc:Text Key='渲染质量'}" Style="{StaticResource SettingsHeading}"/>
                    <Grid Margin="0,4" MinHeight="{DynamicResource UiParameterRowHeight}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Text Key='抗锯齿（FXAA）'}" Style="{StaticResource SettingsLabel}"/>
                        <CheckBox Grid.Column="1" IsChecked="{Binding EnableFXAA}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,4" MinHeight="{DynamicResource UiParameterRowHeight}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Text Key='环境光遮蔽（SSAO）'}" Style="{StaticResource SettingsLabel}"/>
                        <CheckBox Grid.Column="1" IsChecked="{Binding EnableSSAO}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                        <TextBlock Text="{loc:Text Key='SSAO 可改善凹凸阴影，同时增加 GPU 开销。'}" Style="{StaticResource SettingsHint}"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource SettingsCardStyle}"><StackPanel>
                        <TextBlock Text="{loc:Text Key='视图辅助'}" Style="{StaticResource SettingsHeading}"/>
                    <Grid Margin="0,4" MinHeight="{DynamicResource UiParameterRowHeight}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Text Key='显示平台网格'}" Style="{StaticResource SettingsLabel}"/>
                        <CheckBox Grid.Column="1" IsChecked="{Binding ShowBuildGrid}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,4" MinHeight="{DynamicResource UiParameterRowHeight}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Text Key='显示三维坐标轴'}" Style="{StaticResource SettingsLabel}"/>
                        <CheckBox Grid.Column="1" IsChecked="{Binding ShowCoordinateSystem}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,4" MinHeight="{DynamicResource UiParameterRowHeight}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Text Key='显示视角导航立方体'}" Style="{StaticResource SettingsLabel}"/>
                        <CheckBox Grid.Column="1" IsChecked="{Binding ShowViewCube}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,4" MinHeight="{DynamicResource UiParameterRowHeight}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Text Key='显示模式与选择信息'}" Style="{StaticResource SettingsLabel}"/>
                        <CheckBox Grid.Column="1" IsChecked="{Binding ShowViewportStatus}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,4" MinHeight="{DynamicResource UiParameterRowHeight}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Text Key='使用正交视角'}" Style="{StaticResource SettingsLabel}"/>
                        <CheckBox Grid.Column="1" IsChecked="{Binding UseOrthographic}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    </StackPanel></Border>
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsHistorySection, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource SettingsCardStyle}"><StackPanel>
                        <TextBlock Text="{loc:Text Key='操作确认'}" Style="{StaticResource SettingsHeading}"/>
                    <Grid Margin="0,4" MinHeight="{DynamicResource UiParameterRowHeight}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Text Key='删除模型前确认'}" Style="{StaticResource SettingsLabel}"/>
                        <CheckBox Grid.Column="1" IsChecked="{Binding EnableDeleteConfirm}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,4" MinHeight="{DynamicResource UiParameterRowHeight}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Text Key='自动摆放前确认'}" Style="{StaticResource SettingsLabel}"/>
                        <CheckBox Grid.Column="1" IsChecked="{Binding EnableArrangeConfirm}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,4" MinHeight="{DynamicResource UiParameterRowHeight}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Text Key='拆分模型前确认'}" Style="{StaticResource SettingsLabel}"/>
                        <CheckBox Grid.Column="1" IsChecked="{Binding EnableSplitConfirm}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    </StackPanel></Border>
                    <Border Style="{StaticResource SettingsCardStyle}"><StackPanel>
                        <TextBlock Text="{loc:Text Key='撤销与重做'}" Style="{StaticResource SettingsHeading}"/>
                    <Grid Margin="0,4" MinHeight="{DynamicResource UiParameterRowHeight}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Text Key='允许撤销拆分模型'}" Style="{StaticResource SettingsLabel}"/>
                        <CheckBox Grid.Column="1" IsChecked="{Binding SplitUndoable}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,4" MinHeight="{DynamicResource UiParameterRowHeight}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Text Key='历史记录最大步数（0–200）'}" Style="{StaticResource SettingsLabel}"/>
                        <TextBox Grid.Column="1" Text="{Binding UndoStackDepth, UpdateSourceTrigger=LostFocus}" Height="{DynamicResource UiInputHeight}" VerticalAlignment="Center"/>
                    </Grid>
                        <TextBlock Text="{loc:Text Key='0 表示关闭历史记录。拆分撤销和较大的历史深度会增加内存占用。'}" Style="{StaticResource SettingsHint}"/>
                    </StackPanel></Border>
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsRuntimeSection, Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource SettingsCardStyle}"><StackPanel>
                            <TextBlock Text="{loc:Text Key='后端运行'}" Style="{StaticResource SettingsHeading}"/>
                            <Grid Margin="0,4" MinHeight="{DynamicResource UiParameterRowHeight}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Text Key='显示 EngineHost 控制台'}" Style="{StaticResource SettingsLabel}"/>
                                <CheckBox Grid.Column="1" IsChecked="{Binding ShowEngineHostConsole}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="{loc:Text Key='默认在后台运行。开启后显示 Host 日志控制台；下次启动程序时生效。已运行的 Host 会直接复用，切换此选项不会重启服务。'}" Style="{StaticResource SettingsHint}"/>
                            <TextBlock Text="{loc:Text Key='关闭 Host 控制台会结束后端服务，使用过程中请保持它运行。'}" Style="{StaticResource SettingsHint}"/>
                        </StackPanel></Border>
                    </StackPanel>
                    </StackPanel>
            </ScrollViewer>
        </Grid>
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{loc:LocalizedBinding SaveStatus}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
            <Button Grid.Column="1" Content="{loc:Text Key='恢复默认设置'}" Command="{Binding ResetDefaultsCommand}" Style="{StaticResource SecondaryActionButtonStyle}"/>
        </Grid>
    </Grid>
</views:ThemedWindow>
